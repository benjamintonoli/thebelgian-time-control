@page
@model IndexModel
@using TheBelgian.TimeControl.Web.Pages.Admin.Payroll
@{
    ViewData["Title"] = "Overzicht";
    var center = Model.Center;
    string MonthTitle() => center is null
        ? "LOONCONTROLE"
        : TheBelgian.TimeControl.Core.Payroll.Review.MissingTechnicianAdminExplainability.MonthTitleNl(center.Year, center.Month);
}

<div class="tc-home py-4">
    <header class="mb-4">
        <h1 class="display-6 mb-2">TIME CONTROL</h1>
        <p class="lead text-muted mb-0">
            Controle van geregistreerde uren op basis van Plenion, planning en Track &amp; Trace.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning">@Model.Error</div>
    }

    @if (center is null)
    {
        <div class="border rounded p-4">
            <h2 class="h5">Nog geen looncontrole-periode</h2>
            <p class="mb-3 text-muted">Er is nog geen open maand beschikbaar.</p>
            <a class="btn btn-primary" asp-page="/Admin/Payroll/Index" asp-route-Stay="true">Open looncontrole</a>
        </div>
    }
    else
    {
        var s = center.Summary;
        <section class="tc-home-month border rounded p-4 mb-4">
            <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                <div>
                    <h2 class="h4 mb-1">@MonthTitle()</h2>
                    <div class="mb-2">
                        Status:
                        <strong>@PayrollReviewLabels.MonthStatus(center.Status)</strong>
                    </div>
                    <div class="tc-home-stats small">
                        <div><strong>@s.IncludedEmployees</strong> medewerkers</div>
                        <div><strong>@s.ReadyEmployees</strong> klaar</div>
                        <div><strong>@s.AttentionEmployees</strong> nog na te kijken</div>
                        <div><strong>@s.OpenAdminCases</strong> controles te beoordelen</div>
                        <div><strong>@s.FollowUpAdminCases</strong> opvolging</div>
                    </div>
                    <div class="mt-3">
                        <div class="small text-muted mb-1">Voortgang: @s.ProgressPercent%</div>
                        <div class="progress" style="height: 0.6rem; max-width: 20rem;">
                            <div class="progress-bar" role="progressbar" style="width: @(s.ProgressPercent)%"
                                 aria-valuenow="@s.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
                <div>
                    <a class="btn btn-primary btn-lg"
                       asp-page="/Admin/Payroll/Control"
                       asp-route-year="@center.Year"
                       asp-route-month="@center.Month">
                        Ga verder met looncontrole
                    </a>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <h2 class="h5 mb-3">Controles</h2>
            <div class="row g-3">
                @foreach (var card in center.ControlCards)
                {
                    var open = card.Open + card.FollowUp;
                    var muted = open == 0;
                    <div class="col-sm-6 col-lg-4">
                        <a class="tc-home-card card h-100 text-decoration-none @(muted ? "tc-home-card-muted" : "")"
                           asp-page="@card.NavigationPage"
                           asp-route-year="@center.Year"
                           asp-route-month="@center.Month">
                            <div class="card-body">
                                <div class="text-uppercase small text-muted fw-semibold">@card.Title</div>
                                <div class="fs-4 fw-semibold mt-1">@open te beoordelen</div>
                                <div class="small text-muted mt-2">Bekijken →</div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>

        <section class="mb-2">
            <h2 class="h5 mb-3">Volgende te beoordelen</h2>
            @if (center.PriorityQueue.Count == 0)
            {
                <p class="text-muted mb-0">Geen openstaande prioritaire cases.</p>
            }
            else
            {
                <div class="list-group">
                    @foreach (var item in center.PriorityQueue.Take(5))
                    {
                        <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center gap-3"
                           asp-page="@item.NavigationPage"
                           asp-route-year="@center.Year"
                           asp-route-month="@center.Month"
                           asp-route-Focus="@(item.FocusKey ?? item.AdminCaseKey)">
                            <div>
                                <div class="fw-semibold">@(item.DisplayName ?? item.ResourceId)</div>
                                <div class="small text-muted">
                                    @PayrollDisplayFormatting.DateWithWeekdayShort(item.Date)
                                    · @PayrollReviewLabels.Category(item.Category)
                                    @if (!string.IsNullOrWhiteSpace(item.IssueSummary))
                                    {
                                        <span>· @item.IssueSummary</span>
                                    }
                                </div>
                            </div>
                            <span class="btn btn-sm btn-outline-primary">Beoordelen</span>
                        </a>
                    }
                </div>
            }
        </section>
    }
</div>
