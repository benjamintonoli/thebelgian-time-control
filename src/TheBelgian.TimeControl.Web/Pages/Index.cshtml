@page
@model IndexModel
@using TheBelgian.TimeControl.Core.Payroll.Review
@using TheBelgian.TimeControl.Web.Pages.Admin.Payroll
@{
    ViewData["Title"] = "Overzicht";
    var center = Model.Center;
    string MonthTitle() => center is null
        ? "Looncontrole"
        : MissingTechnicianAdminExplainability.MonthTitleNl(center.Year, center.Month);

    string CardHref(PayrollControlCard card) =>
        Url.Page(
            PayrollNavUrls.AbsolutePage(card.NavigationPage),
            PayrollNavUrls.CardRouteValues(card, center!.Year, center.Month))!;

    string PriorityHref(PayrollControlPriorityItem item) =>
        Url.Page(
            PayrollNavUrls.AbsolutePage(item.NavigationPage),
            PayrollNavUrls.PriorityRouteValues(item, center!.Year, center.Month))!;
}

<div class="tc-home py-4">
    <header class="tc-home-hero mb-4">
        <p class="tc-home-kicker mb-1">TIME CONTROL</p>
        <h1 class="h2 mb-2">Controle van geregistreerde uren</h1>
        <p class="text-muted mb-0">
            Op basis van Plenion, planning en Track &amp; Trace.
        </p>
    </header>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-warning">@Model.Error</div>
    }

    @if (center is null)
    {
        <div class="tc-home-panel p-4">
            <h2 class="h5">Nog geen looncontrole-periode</h2>
            <p class="mb-3 text-muted">Er is nog geen open maand beschikbaar.</p>
            <a class="btn btn-primary" asp-page="/Admin/Payroll/Index" asp-route-Stay="true">Open looncontrole</a>
        </div>
    }
    else
    {
        var s = center.Summary;
        <section class="tc-home-panel tc-home-month mb-4">
            <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
                <div class="flex-grow-1">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <h2 class="h3 mb-0">@MonthTitle()</h2>
                        <span class="badge rounded-pill tc-status-badge">@PayrollReviewLabels.MonthStatus(center.Status)</span>
                    </div>
                    <div class="tc-home-stats">
                        <div class="tc-stat">
                            <div class="tc-stat-value">@s.IncludedEmployees</div>
                            <div class="tc-stat-label">Medewerkers</div>
                        </div>
                        <div class="tc-stat tc-stat-ready">
                            <div class="tc-stat-value">@s.ReadyEmployees</div>
                            <div class="tc-stat-label">Klaar</div>
                        </div>
                        <div class="tc-stat tc-stat-attention">
                            <div class="tc-stat-value">@s.AttentionEmployees</div>
                            <div class="tc-stat-label">Nog te bekijken</div>
                        </div>
                        <div class="tc-stat">
                            <div class="tc-stat-value">@s.OpenAdminCases</div>
                            <div class="tc-stat-label">Te beoordelen</div>
                        </div>
                        <div class="tc-stat">
                            <div class="tc-stat-value">@s.FollowUpAdminCases</div>
                            <div class="tc-stat-label">Opvolging</div>
                        </div>
                    </div>
                    <div class="mt-3" style="max-width: 22rem;">
                        <div class="d-flex justify-content-between small text-muted mb-1">
                            <span>Voortgang</span>
                            <span>@s.ProgressPercent%</span>
                        </div>
                        <div class="progress tc-home-progress">
                            <div class="progress-bar" role="progressbar" style="width: @(s.ProgressPercent)%"
                                 aria-valuenow="@s.ProgressPercent" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>
                </div>
                <div>
                    <a class="btn btn-primary btn-lg"
                       asp-page="/Admin/Payroll/Control"
                       asp-route-year="@center.Year"
                       asp-route-month="@center.Month">
                        Ga verder met looncontrole
                    </a>
                </div>
            </div>
        </section>

        <section class="mb-4">
            <h2 class="h5 mb-3">Controles</h2>
            <div class="row g-3">
                @foreach (var card in center.ControlCards)
                {
                    var open = card.Open + card.FollowUp;
                    var tone = PayrollNavUrls.CardToneClass(card);
                    <div class="col-sm-6 col-lg-4">
                        <a class="tc-home-card @tone"
                           href="@CardHref(card)"
                           aria-label="@card.Title — @open te beoordelen">
                            <div class="tc-home-card-body">
                                <div class="tc-home-card-title">@card.Title</div>
                                <div class="tc-home-card-count">@open</div>
                                <div class="tc-home-card-sub">@PayrollNavUrls.CardSubtitle(card)</div>
                                <div class="tc-home-card-action">@(open == 0 ? "Bekijken" : "Openen") →</div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </section>

        <section class="mb-4">
            <h2 class="h5 mb-3">Volgende te beoordelen</h2>
            @if (center.PriorityQueue.Count == 0)
            {
                <p class="text-muted mb-0">Geen openstaande prioritaire cases.</p>
            }
            else
            {
                <div class="tc-next-list">
                    @foreach (var item in center.PriorityQueue.Take(5))
                    {
                        <a class="tc-next-item" href="@PriorityHref(item)">
                            <div class="tc-next-main">
                                <div class="fw-semibold">@(item.DisplayName ?? item.ResourceId)</div>
                                <div class="small text-muted">
                                    @PayrollDisplayFormatting.DateWithWeekdayShort(item.Date)
                                    · @PayrollReviewLabels.Category(item.Category)
                                    @if (!string.IsNullOrWhiteSpace(item.IssueSummary))
                                    {
                                        <span>· @item.IssueSummary</span>
                                    }
                                </div>
                            </div>
                            <span class="btn btn-sm btn-outline-primary tc-next-cta">Beoordelen</span>
                        </a>
                    }
                </div>
            }
        </section>

        <section class="tc-home-quicklinks">
            <h2 class="h6 text-muted mb-2">Snelkoppelingen</h2>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-sm btn-outline-secondary"
                   asp-page="/Admin/Reviews/Index"
                   asp-route-tab="Completed"
                   asp-route-category="Completed">Afgehandeld</a>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Payroll/Employees">Medewerkers</a>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/TimeControl/VehicleAssignments">Beheer · Voertuigen</a>
                <a class="btn btn-sm btn-outline-secondary" asp-page="/Admin/Patterns/Index">Beheer · Patronen</a>
            </div>
        </section>
    }
</div>
