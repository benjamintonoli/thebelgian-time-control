@inject IWebHostEnvironment HostEnvironment
@inject TheBelgian.TimeControl.Core.Interfaces.ICurrentUserContext CurrentUserContext
@inject Microsoft.Extensions.Options.IOptions<TheBelgian.TimeControl.Infrastructure.Configuration.CloudflareAccessOptions> CloudflareAccessOptions
@inject Microsoft.Extensions.Options.IOptions<TheBelgian.TimeControl.Infrastructure.Configuration.AdminReviewWorkflowOptions> AdminReviewOptions
@{
    var isAdmin = Context.Request.Path.StartsWithSegments("/Admin");
    var signedInUser = CurrentUserContext.CurrentUser;
}
<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - The Belgian Time Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TheBelgian.TimeControl.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="@(isAdmin ? "admin-shell" : "container")">
                <a class="navbar-brand" asp-area="" asp-page="/Index">The Belgian Time Control</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 align-items-sm-center">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/TimeControl/Index">Time Control</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/TimeControl/VehicleAssignments">Voertuiginitialisatie</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/Reviews/Index">Reviews</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark"
                               asp-page="/Admin/Reviews/Index"
                               asp-route-tab="Completed"
                               asp-route-category="Completed">Afgehandeld</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-page="/Admin/Patterns/Index">Patronen</a>
                        </li>
                        @if (HostEnvironment.IsDevelopment())
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-dark" href="#" id="devNav" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Development</a>
                                <ul class="dropdown-menu" aria-labelledby="devNav">
                                    <li><a class="dropdown-item" asp-page="/Exceptions/Index">Afwijkingen</a></li>
                                    <li><a class="dropdown-item" asp-page="/Pilot/Index">Read-only pilot</a></li>
                                    <li><a class="dropdown-item" asp-page="/Pilot/Broader">Bredere validatie</a></li>
                                    <li><a class="dropdown-item" asp-page="/Pilot/BenchmarkReview">Benchmark review</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    @if (isAdmin)
                    {
                        <div class="small text-muted text-sm-end">
                            @if (signedInUser is not null)
                            {
                                <div>Aangemeld als:</div>
                                <div><strong>@signedInUser.Email</strong></div>
                                @if (!string.IsNullOrWhiteSpace(signedInUser.DisplayName) &&
                                     !string.Equals(signedInUser.DisplayName, signedInUser.Email, StringComparison.OrdinalIgnoreCase))
                                {
                                    <div>@signedInUser.DisplayName</div>
                                }
                            }
                            else if (!CloudflareAccessOptions.Value.Enabled)
                            {
                                <div>Aangemeld als:</div>
                                <div><strong>@AdminReviewOptions.Value.DefaultReviewer</strong></div>
                                <div class="text-muted">lokaal fallback</div>
                            }
                        </div>
                    }
                </div>
            </div>
        </nav>
    </header>
    <div class="@(isAdmin ? "admin-shell" : "container")">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="@(isAdmin ? "admin-shell" : "container")">
            &copy; 2026 The Belgian · fase 1 · read-only
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
