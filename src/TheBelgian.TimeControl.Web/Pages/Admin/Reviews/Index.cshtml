@page "/Admin/Reviews"
@model TheBelgian.TimeControl.Web.Pages.Admin.Reviews.IndexModel
@using TheBelgian.TimeControl.Core.Models
@using TheBelgian.TimeControl.Core.Services
@{
    ViewData["Title"] = "Admin Reviews";
    var counts = Model.Result.Counts;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Result.TotalMatching / (double)Model.Result.PageSize));
    string PriorityBadgeClass(SpotcheckPriorityTier? tier) => tier switch
    {
        SpotcheckPriorityTier.HighPriority => "bg-danger",
        SpotcheckPriorityTier.IndividualException => "bg-warning text-dark",
        SpotcheckPriorityTier.SmallDeviation => "bg-info text-dark",
        SpotcheckPriorityTier.Informational => "bg-secondary",
        _ => "bg-light text-dark border"
    };
    string TabClass(ReviewWorkTab tab) =>
        Model.Tab == tab ? "nav-link active" : "nav-link";
}

<div class="alert alert-warning" role="alert">
    <strong>@MatcherUsagePolicy.BannerTitle</strong><br />
    @MatcherUsagePolicy.BannerBody
</div>

<h1>Admin Reviews</h1>
<p class="text-muted">Werklijst voor menselijke bevestiging van matchervoorstellen.</p>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Te beoordelen</div>
            <div class="fs-3">@counts.ToReview</div>
            <div class="small text-muted">@counts.ActionableDeviation actie · @counts.SmallDeviation klein</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Koppeling onzeker</div>
            <div class="fs-3">@counts.MatchUncertainty</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Datakwaliteit</div>
            <div class="fs-3">@counts.DataQuality</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Afgehandeld</div>
            <div class="fs-3">@counts.Completed</div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.ToReview)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.ToReview"
           asp-route-category="@ReviewWorkCategory.ActionableDeviation"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Te beoordelen (@counts.ToReview)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.MatchUncertainty)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.MatchUncertainty"
           asp-route-category="@ReviewWorkCategory.MatchUncertainty"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Koppeling onzeker (@counts.MatchUncertainty)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.DataQuality)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.DataQuality"
           asp-route-category="@ReviewWorkCategory.DataQuality"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Datakwaliteit (@counts.DataQuality)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.Completed)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.Completed"
           asp-route-category="@ReviewWorkCategory.Completed"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Afgehandeld (@counts.Completed)
        </a>
    </li>
</ul>

<form method="get" class="border rounded p-3 mb-4">
    <input type="hidden" name="Tab" value="@Model.Tab" />
    <input type="hidden" name="Category" value="@Model.Category" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" asp-for="Technician">Technieker</label>
            <input class="form-control" asp-for="Technician" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="FromDate">Van</label>
            <input class="form-control" asp-for="FromDate" type="date" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="ThroughDate">Tot</label>
            <input class="form-control" asp-for="ThroughDate" type="date" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filteren</button>
        </div>
    </div>
</form>

<p class="text-muted">
    @Model.Result.TotalMatching resultaat(en)
    · pagina @Model.Result.Page / @totalPages
    · standaard: te beoordelen afwijkingen ≥ 15 min (Pending / NeedsMoreInformation)
</p>

<div class="admin-review-table-wrap table-responsive">
    <table class="table table-sm table-striped align-middle admin-review-table">
        <thead>
            <tr>
                <th>Prioriteit</th>
                <th>Datum</th>
                <th>Technieker</th>
                <th>Plenion-tijd</th>
                <th>Plenion-adres</th>
                <th>Voorgesteld bezoek</th>
                <th>Startafwijking</th>
                <th>Eindafwijking</th>
                <th>Matcherstatus</th>
                <th>Reviewstatus</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Result.Items)
        {
            <tr>
                <td>
                    @if (item.Priority is { } priority)
                    {
                        <span class="badge @PriorityBadgeClass(priority)">@AdminReviewDisplay.Priority(priority)</span>
                    }
                    else
                    {
                        <span class="text-muted">—</span>
                    }
                    @if (item.HasRecurringConfirmedPattern)
                    {
                        <span class="badge bg-light text-dark border" title="Terugkerend bevestigd patroon (reviewcontext).">patroon</span>
                    }
                </td>
                <td class="text-nowrap">
                    <a asp-page="./Details" asp-route-performanceId="@item.PerformanceId">@item.Date.ToString("yyyy-MM-dd")</a>
                </td>
                <td>@item.Technician</td>
                <td class="small text-nowrap">
                    @item.Source.PlenionStart.ToString("HH:mm")–@item.Source.PlenionEnd.ToString("HH:mm")
                </td>
                <td class="small" title="@item.Source.PlenionAddress">
                    @AdminReviewDisplay.Truncate(item.Source.PlenionAddress)
                </td>
                <td class="small" title="@(item.Matcher.ProposedVisit?.Address)">
                    @AdminReviewDisplay.VisitSummary(item.Matcher.ProposedVisit)
                </td>
                <td class="text-nowrap">@AdminReviewDisplay.Deviation(item.Matcher.StartDeviationMinutes)</td>
                <td class="text-nowrap">@AdminReviewDisplay.Deviation(item.Matcher.EndDeviationMinutes)</td>
                <td>@AdminReviewDisplay.MatcherStatus(item.MatcherStatus)</td>
                <td>@item.ReviewStatus</td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Paginering">
        <ul class="pagination">
            <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : null)">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-tab="@Model.Tab"
                   asp-route-category="@Model.Category"
                   asp-route-technician="@Model.Technician"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")"
                   asp-route-pageNumber="@(Model.Result.Page - 1)">Vorige</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Result.Page / @totalPages</span></li>
            <li class="page-item @(Model.Result.Page >= totalPages ? "disabled" : null)">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-tab="@Model.Tab"
                   asp-route-category="@Model.Category"
                   asp-route-technician="@Model.Technician"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")"
                   asp-route-pageNumber="@(Model.Result.Page + 1)">Volgende</a>
            </li>
        </ul>
    </nav>
}
