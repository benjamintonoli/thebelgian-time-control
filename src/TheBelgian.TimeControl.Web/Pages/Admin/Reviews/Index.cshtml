@page "/Admin/Reviews"
@model TheBelgian.TimeControl.Web.Pages.Admin.Reviews.IndexModel
@using TheBelgian.TimeControl.Core.Models
@using TheBelgian.TimeControl.Core.Services
@{
    ViewData["Title"] = "Reviews";
    var counts = Model.Result.Counts;
    var totalPages = Math.Max(1, (int)Math.Ceiling(Model.Result.TotalMatching / (double)Model.Result.PageSize));
    string TabClass(ReviewWorkTab tab) =>
        Model.Tab == tab ? "nav-link active" : "nav-link";
}

<div class="alert alert-warning mb-3" role="alert">
    <strong>@MatcherUsagePolicy.BannerTitle</strong><br />
    @MatcherUsagePolicy.BannerBody
</div>

<details class="mb-4">
    <summary class="fw-semibold">Technische informatie</summary>
    <dl class="small mt-2 mb-0">
        <dt>Finale holdoutbeslissing</dt>
        <dd>@MatcherUsagePolicy.HoldoutDecision — geen verdere holdouttuning</dd>
        <dt>Provider</dt>
        <dd>@Model.DataSourceName</dd>
        <dt>Automatische acceptatie / writeback</dt>
        <dd>
            Auto-accept: @MatcherUsagePolicy.AutomaticAcceptanceAllowed ·
            Plenion-writeback: @MatcherUsagePolicy.PlenionWritebackAllowed
        </dd>
        <dt>Matchercommit / configuratiehash</dt>
        <dd class="text-muted">Per case zichtbaar op de detailpagina (inklapbaar).</dd>
    </dl>
</details>

<h1 class="mb-1">Reviews</h1>
<p class="text-muted mb-4">Werklijst: openen → begrijpen → bewijs vergelijken → beslissen → audit controleren.</p>

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<div class="row g-3 mb-4">
    <div class="col-lg-3 col-md-6">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Openstaand</div>
            <div class="fs-3">@counts.OpenOutstanding</div>
            <div class="small text-muted">
                @counts.Exceptions uitzonderingen · @counts.SmallDeviation kleine afwijkingen
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Koppeling onzeker</div>
            <div class="fs-3">@counts.MatchUncertainty</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Datakwaliteit</div>
            <div class="fs-3">@counts.DataQuality</div>
        </div>
    </div>
    <div class="col-lg-3 col-md-6">
        <div class="border rounded p-3 h-100">
            <div class="text-muted small">Afgehandeld</div>
            <div class="fs-3">@counts.Completed</div>
        </div>
    </div>
</div>

<ul class="nav nav-tabs mb-3 flex-wrap">
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.Exceptions)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.Exceptions"
           asp-route-category="@ReviewWorkCategory.ActionableDeviation"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Uitzonderingen (@counts.Exceptions)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.SmallDeviations)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.SmallDeviations"
           asp-route-category="@ReviewWorkCategory.SmallDeviation"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Kleine afwijkingen (@counts.SmallDeviation)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.MatchUncertainty)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.MatchUncertainty"
           asp-route-category="@ReviewWorkCategory.MatchUncertainty"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Koppeling onzeker (@counts.MatchUncertainty)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.DataQuality)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.DataQuality"
           asp-route-category="@ReviewWorkCategory.DataQuality"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Datakwaliteit (@counts.DataQuality)
        </a>
    </li>
    <li class="nav-item">
        <a class="@TabClass(ReviewWorkTab.Completed)"
           asp-page="./Index"
           asp-route-tab="@ReviewWorkTab.Completed"
           asp-route-category="@ReviewWorkCategory.Completed"
           asp-route-technician="@Model.Technician"
           asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
           asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")">
            Afgehandeld (@counts.Completed)
        </a>
    </li>
</ul>

<form method="get" class="border rounded p-3 mb-4">
    <input type="hidden" name="Tab" value="@Model.Tab" />
    <input type="hidden" name="Category" value="@Model.Category" />
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label" asp-for="Technician">Technieker</label>
            <input class="form-control" asp-for="Technician" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="FromDate">Van</label>
            <input class="form-control" asp-for="FromDate" type="date" />
        </div>
        <div class="col-md-3">
            <label class="form-label" asp-for="ThroughDate">Tot</label>
            <input class="form-control" asp-for="ThroughDate" type="date" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button type="submit" class="btn btn-primary w-100">Filteren</button>
        </div>
    </div>
</form>

<p class="text-muted">
    @Model.Result.TotalMatching zichtbaar in deze tab
    · pagina @Model.Result.Page / @totalPages
    · max @Model.Result.PageSize per pagina
</p>

<div class="admin-review-table-wrap table-responsive">
    <table class="table table-hover align-middle admin-review-table">
        <thead>
            <tr>
                <th>Impact</th>
                <th>Datum</th>
                <th>Technieker</th>
                <th>Geboekte tijd</th>
                <th>Plenion-adres</th>
                <th>Voorgesteld bezoek</th>
                <th>Aankomst t.o.v. boeking</th>
                <th>Vertrek t.o.v. boeking</th>
                <th>Bewijs</th>
                <th>Reviewstatus</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model.Result.Items)
        {
            var evidence = AdminReviewDisplay.Evidence(item.MatcherStatus);
            <tr class="review-row"
                tabindex="0"
                data-href="@item.DetailPath"
                role="link"
                aria-label="Review @item.PerformanceId openen">
                <td>
                    <span class="badge @AdminReviewDisplay.ImpactBadgeClass(item.Priority)">
                        @AdminReviewDisplay.Impact(item.Priority)
                    </span>
                </td>
                <td class="text-nowrap">@item.Date.ToString("yyyy-MM-dd")</td>
                <td>@item.Technician</td>
                <td class="text-nowrap">
                    @item.Source.PlenionStart.ToString("HH:mm")–@item.Source.PlenionEnd.ToString("HH:mm")
                </td>
                <td class="col-address" title="@item.Source.PlenionAddress">
                    @AdminReviewDisplay.Truncate(item.Source.PlenionAddress, 42)
                </td>
                <td class="col-visit" title="@(item.Matcher.ProposedVisit?.Address)">
                    @if (item.Matcher.ProposedVisit is null)
                    {
                        <span class="text-muted">—</span>
                    }
                    else
                    {
                        <span class="visit-line-primary">@AdminReviewDisplay.VisitAddressLine(item.Matcher.ProposedVisit)</span>
                        <span class="visit-line-secondary">@AdminReviewDisplay.VisitMetricsLine(item.Matcher.ProposedVisit)</span>
                    }
                </td>
                <td class="text-nowrap">@AdminReviewDisplay.Deviation(item.Matcher.StartDeviationMinutes)</td>
                <td class="text-nowrap">@AdminReviewDisplay.Deviation(item.Matcher.EndDeviationMinutes)</td>
                <td>
                    <span class="badge @AdminReviewDisplay.EvidenceBadgeClass(evidence)">
                        @AdminReviewDisplay.EvidenceLabel(evidence)
                    </span>
                </td>
                <td>@item.ReviewStatus</td>
                <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-page="./Details"
                       asp-route-performanceId="@item.PerformanceId"
                       onclick="event.stopPropagation()">Bekijken →</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3" aria-label="Paginering">
        <ul class="pagination">
            <li class="page-item @(Model.Result.Page <= 1 ? "disabled" : null)">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-tab="@Model.Tab"
                   asp-route-category="@Model.Category"
                   asp-route-technician="@Model.Technician"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")"
                   asp-route-pageNumber="@(Model.Result.Page - 1)">Vorige</a>
            </li>
            <li class="page-item disabled"><span class="page-link">@Model.Result.Page / @totalPages</span></li>
            <li class="page-item @(Model.Result.Page >= totalPages ? "disabled" : null)">
                <a class="page-link"
                   asp-page="./Index"
                   asp-route-tab="@Model.Tab"
                   asp-route-category="@Model.Category"
                   asp-route-technician="@Model.Technician"
                   asp-route-fromDate="@Model.FromDate?.ToString("yyyy-MM-dd")"
                   asp-route-throughDate="@Model.ThroughDate?.ToString("yyyy-MM-dd")"
                   asp-route-pageNumber="@(Model.Result.Page + 1)">Volgende</a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
<script>
(() => {
  const go = (row) => {
    const href = row?.getAttribute('data-href');
    if (href) window.location.href = href;
  };
  document.querySelectorAll('tr.review-row').forEach((row) => {
    row.addEventListener('click', () => go(row));
    row.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' || event.key === ' ') {
        event.preventDefault();
        go(row);
      }
    });
  });
})();
</script>
}
