@page "/Admin/Reviews/{performanceId:long}"
@model TheBelgian.TimeControl.Web.Pages.Admin.Reviews.DetailsModel
@using TheBelgian.TimeControl.Core.Models
@using TheBelgian.TimeControl.Core.Services
@{
    ViewData["Title"] = $"Review {Model.PerformanceId}";
    var item = Model.Case;
}

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<p class="mb-3"><a asp-page="./Index">&larr; Terug naar reviews</a></p>

@if (item is null)
{
    <p>Case niet gevonden.</p>
}
else
{
    var evidence = AdminReviewDisplay.Evidence(item.MatcherStatus);
    <div class="review-detail-hero">
        <div>
            <div class="text-muted small">Technieker</div>
            <div class="fw-semibold">@item.Technician</div>
        </div>
        <div>
            <div class="text-muted small">Datum</div>
            <div class="fw-semibold text-nowrap">@item.Date.ToString("yyyy-MM-dd")</div>
        </div>
        <div>
            <div class="text-muted small">Geboekte tijd</div>
            <div class="fw-semibold text-nowrap">
                @item.Source.PlenionStart.ToString("HH:mm")–@item.Source.PlenionEnd.ToString("HH:mm")
            </div>
        </div>
        <div>
            <span class="badge @AdminReviewDisplay.ImpactBadgeClass(item.Priority)">
                @AdminReviewDisplay.Impact(item.Priority)
            </span>
        </div>
        <div>
            <span class="badge @AdminReviewDisplay.EvidenceBadgeClass(evidence)">
                @AdminReviewDisplay.EvidenceLabel(evidence)
            </span>
        </div>
        <div>
            <div class="text-muted small">Reviewstatus</div>
            <div class="fw-semibold">@item.ReviewStatus</div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(item.DeterministicExplanation))
    {
        <div class="alert alert-secondary">@item.DeterministicExplanation</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <section class="review-panel review-panel-booked">
                <h2>A. Geboekte prestatie</h2>
                <dl class="small mb-0">
                    <dt>Prestatie</dt>
                    <dd>@item.PerformanceId</dd>
                    <dt>Plenion-start / -einde</dt>
                    <dd class="text-nowrap">
                        @item.Source.PlenionStart.ToString("yyyy-MM-dd HH:mm") –
                        @item.Source.PlenionEnd.ToString("HH:mm")
                    </dd>
                    <dt>Adres</dt>
                    <dd>@item.Source.PlenionAddress</dd>
                    <dt>Klant / project / bon</dt>
                    <dd>
                        @(item.Source.CustomerContext ?? "—") /
                        @(item.Source.ProjectContext ?? "—") /
                        @(item.Source.BonContext ?? "—")
                    </dd>
                    <dt>Vorige prestatie</dt>
                    <dd>@(item.Source.PreviousPerformance ?? "—")</dd>
                    <dt>Volgende prestatie</dt>
                    <dd>@(item.Source.NextPerformance ?? "—")</dd>
                    <dt>Aankomst / vertrek t.o.v. boeking</dt>
                    <dd>
                        @AdminReviewDisplay.Deviation(item.Matcher.StartDeviationMinutes)
                        /
                        @AdminReviewDisplay.Deviation(item.Matcher.EndDeviationMinutes)
                    </dd>
                </dl>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="review-panel review-panel-evidence">
                <h2>B. Powerfleet-bewijs</h2>
                <dl class="small">
                    <dt>Voorgesteld bezoek</dt>
                    <dd>
                        @if (item.Matcher.ProposedVisit is null)
                        {
                            <span>—</span>
                        }
                        else
                        {
                            <span class="visit-line-primary">@AdminReviewDisplay.VisitAddressLine(item.Matcher.ProposedVisit)</span>
                            <span class="visit-line-secondary">@AdminReviewDisplay.VisitMetricsLine(item.Matcher.ProposedVisit)</span>
                        }
                    </dd>
                    <dt>Geocodekwaliteit</dt>
                    <dd>@item.Matcher.GeocodeQuality</dd>
                    <dt>ConstituentStopIds (voorstel)</dt>
                    <dd class="font-monospace">
                        @(item.Matcher.ProposedVisit is null
                            ? "—"
                            : string.Join(", ", item.Matcher.ProposedVisit.ConstituentStopIds))
                    </dd>
                    <dt>Matchreden</dt>
                    <dd>@item.Matcher.MatchReason</dd>
                </dl>
                <h3 class="h6">Alternatieve kandidaatbezoeken</h3>
                <div class="table-responsive">
                    <table class="table table-sm mb-0">
                        <thead>
                            <tr>
                                <th>Bezoek</th>
                                <th>StopIds</th>
                                <th>m</th>
                                <th>Overlap</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var visit in item.Matcher.CandidateVisits)
                        {
                            <tr>
                                <td class="small">
                                    <span class="visit-line-primary">@AdminReviewDisplay.VisitAddressLine(visit)</span>
                                    <span class="visit-line-secondary text-nowrap">@visit.Arrival.ToString("HH:mm")–@visit.Departure.ToString("HH:mm")</span>
                                </td>
                                <td class="font-monospace small">@string.Join(", ", visit.ConstituentStopIds)</td>
                                <td>@(visit.DistanceMeters?.ToString("0") ?? "—")</td>
                                <td>@visit.OverlapMinutes / @visit.OverlapPercent.ToString("0")%</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
        <div class="col-lg-4">
            <section class="review-panel review-panel-decision">
                <h2>C. Beoordeling</h2>
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label" asp-for="Action">Actie</label>
                        <select class="form-select" asp-for="Action">
                            <option value="@((int)DetailsModel.ReviewActionKind.ConfirmProposal)">Voorstel bevestigen</option>
                            <option value="@((int)DetailsModel.ReviewActionKind.ChooseOtherCandidate)">Andere kandidaat kiezen</option>
                            <option value="@((int)DetailsModel.ReviewActionKind.RejectProposal)">Voorstel afwijzen</option>
                            <option value="@((int)DetailsModel.ReviewActionKind.NoReliableMatch)">Geen betrouwbare match</option>
                            <option value="@((int)DetailsModel.ReviewActionKind.NeedsMoreInformation)">Meer informatie nodig</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="ChosenVisitCandidateId">Kandidaatbezoek</label>
                        <select class="form-select" asp-for="ChosenVisitCandidateId">
                            <option value="">(geen)</option>
                            @foreach (var visit in item.Matcher.CandidateVisits)
                            {
                                <option value="@visit.VisitCandidateId">
                                    @AdminReviewDisplay.VisitAddressLine(visit) · @visit.Arrival.ToString("HH:mm")–@visit.Departure.ToString("HH:mm")
                                </option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label" asp-for="Comment">Opmerking / reden</label>
                        <textarea class="form-control" asp-for="Comment" rows="3"></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Beslissing opslaan</button>
                    <p class="small text-muted mt-2 mb-0">
                        Beslissing wordt opgeslagen onder de aangemelde gebruiker.
                        Afwijzing vereist reden. Andere kandidaat vereist opmerking.
                        Oorspronkelijke matcheruitkomst blijft bewaard. Geen Plenion-writeback.
                    </p>
                </form>
            </section>
        </div>
    </div>

    <details class="mb-4">
        <summary class="fw-semibold">Technische informatie</summary>
        <dl class="small mt-2">
            <dt>Bronprovenance</dt>
            <dd>@string.Join(", ", item.SourceProvenance)</dd>
            <dt>Interne matcherstatus</dt>
            <dd class="font-monospace">@item.Matcher.MatcherStatus</dd>
            <dt>Matchercommit</dt>
            <dd class="font-monospace">@item.Matcher.MatcherCommit</dd>
            <dt>Configuratiehash</dt>
            <dd class="font-monospace">@item.Matcher.ConfigurationHash</dd>
            <dt>Holdoutbeslissing</dt>
            <dd>@MatcherUsagePolicy.HoldoutDecision</dd>
        </dl>
    </details>

    <h2 class="h5">Audittrail</h2>
    <p class="audit-note">
        Beslissingen zijn append-only: eerdere rijen blijven staan en worden nooit overschreven.
    </p>
    @if (Model.IsLivePilot)
    {
        <p class="small text-muted">Read-only pilot — geen automatische correcties.</p>
    }
    @if (Model.SessionMetrics.Count > 0)
    {
        <div class="table-responsive mb-3">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Geopend</th>
                        <th>Beslist</th>
                        <th>Duur (s)</th>
                        <th>Beslissing</th>
                        <th>Matcherstatus</th>
                        <th>Voorstel bevestigd</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var metric in Model.SessionMetrics)
                {
                    <tr>
                        <td class="small text-nowrap">@metric.OpenedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td class="small text-nowrap">@(metric.DecidedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "—")</td>
                        <td>@(metric.DurationSeconds is null ? "—" : metric.DurationSeconds.Value.ToString("0"))</td>
                        <td>@(metric.Decision ?? "—")</td>
                        <td>@(metric.MatcherStatus is null ? "—" : AdminReviewDisplay.EvidenceLabel(metric.MatcherStatus))</td>
                        <td>@(metric.ProposedCandidateConfirmed is null ? "—" : (metric.ProposedCandidateConfirmed.Value ? "ja" : "nee"))</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    @if (Model.AuditTrail.Count == 0)
    {
        <p class="text-muted">Nog geen beslissingen.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tijdstip</th>
                        <th>Reviewer</th>
                        <th>Beslissing</th>
                        <th>Gekozen bezoek</th>
                        <th>Reden / opmerking</th>
                        <th>Oorspr. matcher</th>
                        <th>Commit</th>
                        <th>Config</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.AuditTrail)
                {
                    <tr>
                        <td class="small text-nowrap">@row.DecidedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@row.Reviewer</td>
                        <td>@row.Decision</td>
                        <td class="font-monospace small">@(row.ChosenVisitCandidateId ?? "—")</td>
                        <td class="small">@(row.ReasonOrComment ?? "—")</td>
                        <td>@AdminReviewDisplay.EvidenceLabel(row.OriginalMatcherStatus)</td>
                        <td class="font-monospace small">@row.MatcherCommit</td>
                        <td class="font-monospace small">@row.ConfigurationHash[..Math.Min(12, row.ConfigurationHash.Length)]…</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
