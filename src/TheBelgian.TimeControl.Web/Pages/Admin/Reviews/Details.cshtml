@page "/Admin/Reviews/{performanceId:long}"
@model TheBelgian.TimeControl.Web.Pages.Admin.Reviews.DetailsModel
@using TheBelgian.TimeControl.Core.Models
@{
    ViewData["Title"] = $"Review {Model.PerformanceId}";
    var item = Model.Case;
}

<div class="alert alert-warning" role="alert">
    Read-only pilot — matcherresultaten vereisen menselijke bevestiging.
</div>

<p><a asp-page="./Index">&larr; Terug naar reviewlijst</a></p>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

@if (item is null)
{
    <p>Case niet gevonden.</p>
}
else
{
    <h1>Review @item.PerformanceId</h1>
    <p class="text-muted mb-4">
        Prioriteit: <strong>@item.Priority</strong>
        · Matcher: <strong>@item.MatcherStatus</strong>
        · Review: <strong>@item.ReviewStatus</strong>
        @if (item.RecurringSmallAdvantage)
        {
            <span class="badge bg-light text-dark border">terugkerende kleine voordelen (reviewcontext)</span>
        }
    </p>

    @if (!string.IsNullOrWhiteSpace(item.DeterministicExplanation))
    {
        <div class="alert alert-secondary">@item.DeterministicExplanation</div>
    }

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <h2 class="h5">A. Plenion</h2>
            <dl class="small">
                <dt>Prestatie</dt>
                <dd>@item.PerformanceId · @item.Date · @item.Technician</dd>
                <dt>Tijd</dt>
                <dd>@item.Source.PlenionStart.ToString("yyyy-MM-dd HH:mm") – @item.Source.PlenionEnd.ToString("HH:mm")</dd>
                <dt>Adres</dt>
                <dd>@item.Source.PlenionAddress</dd>
                <dt>Project / bon / klant</dt>
                <dd>
                    @(item.Source.ProjectContext ?? "—")
                    / @(item.Source.BonContext ?? "—")
                    / @(item.Source.CustomerContext ?? "—")
                </dd>
                <dt>Vorige prestatie</dt>
                <dd>@(item.Source.PreviousPerformance ?? "—")</dd>
                <dt>Volgende prestatie</dt>
                <dd>@(item.Source.NextPerformance ?? "—")</dd>
            </dl>
        </div>
        <div class="col-lg-4">
            <h2 class="h5">B. Powerfleet / matcher</h2>
            <dl class="small">
                <dt>Status / reden</dt>
                <dd>@item.Matcher.MatcherStatus — @item.Matcher.MatchReason</dd>
                <dt>Geocodekwaliteit</dt>
                <dd>@item.Matcher.GeocodeQuality</dd>
                <dt>Voorgesteld bezoek</dt>
                <dd class="font-monospace">@(item.Matcher.ProposedVisit?.VisitCandidateId ?? "—")</dd>
                <dt>Matchercommit / confighash</dt>
                <dd class="font-monospace small">@item.Matcher.MatcherCommit<br />@item.Matcher.ConfigurationHash</dd>
            </dl>
            <h3 class="h6">Kandidaatbezoeken</h3>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Stops</th>
                            <th>Aankomst</th>
                            <th>Vertrek</th>
                            <th>m</th>
                            <th>Overlap</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var visit in item.Matcher.CandidateVisits)
                    {
                        <tr>
                            <td class="font-monospace small">@visit.VisitCandidateId</td>
                            <td class="small">@string.Join(", ", visit.ConstituentStopIds)</td>
                            <td class="small">@visit.Arrival.ToString("HH:mm")</td>
                            <td class="small">@visit.Departure.ToString("HH:mm")</td>
                            <td>@(visit.DistanceMeters?.ToString("0") ?? "—")</td>
                            <td>@visit.OverlapMinutes / @visit.OverlapPercent.ToString("0")%</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="col-lg-4">
            <h2 class="h5">C. Adminbeslissing</h2>
            <form method="post" class="border rounded p-3">
                <div class="mb-2">
                    <label class="form-label" asp-for="Decision">Beslissing</label>
                    <select class="form-select" asp-for="Decision" asp-items="Html.GetEnumSelectList<AdminReviewStatus>()"></select>
                </div>
                <div class="mb-2">
                    <label class="form-label" asp-for="ChosenVisitCandidateId">Gekozen bezoek</label>
                    <select class="form-select" asp-for="ChosenVisitCandidateId">
                        <option value="">(geen)</option>
                        @foreach (var visit in item.Matcher.CandidateVisits)
                        {
                            <option value="@visit.VisitCandidateId">@visit.VisitCandidateId</option>
                        }
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label" asp-for="Reviewer">Reviewer</label>
                    <input class="form-control" asp-for="Reviewer" required />
                </div>
                <div class="mb-2">
                    <label class="form-label" asp-for="Comment">Opmerking / reden</label>
                    <textarea class="form-control" asp-for="Comment" rows="3"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">Opslaan</button>
                <p class="small text-muted mt-2 mb-0">
                    Confirmed vereist reviewer. Rejected vereist reden.
                    Andere kandidaat vereist opmerking. Geen Plenion-writeback.
                </p>
            </form>
        </div>
    </div>

    <h2 class="h5">Audittrail</h2>
    @if (Model.AuditTrail.Count == 0)
    {
        <p class="text-muted">Nog geen beslissingen.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>Tijd</th>
                        <th>Reviewer</th>
                        <th>Beslissing</th>
                        <th>Oorspr. matcher</th>
                        <th>Voorstel</th>
                        <th>Gekozen</th>
                        <th>Reden</th>
                        <th>Commit</th>
                        <th>Config</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in Model.AuditTrail)
                {
                    <tr>
                        <td class="small">@row.DecidedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>@row.Reviewer</td>
                        <td>@row.Decision</td>
                        <td>@row.OriginalMatcherStatus</td>
                        <td class="font-monospace small">@(row.ProposedVisitCandidateId ?? "—")</td>
                        <td class="font-monospace small">@(row.ChosenVisitCandidateId ?? "—")</td>
                        <td class="small">@(row.ReasonOrComment ?? "—")</td>
                        <td class="font-monospace small">@row.MatcherCommit</td>
                        <td class="font-monospace small">@row.ConfigurationHash[..Math.Min(12, row.ConfigurationHash.Length)]…</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
