@page "/Admin/TimeControl"
@model TheBelgian.TimeControl.Web.Pages.Admin.TimeControl.IndexModel
@using TheBelgian.TimeControl.Core.Models
@using TheBelgian.TimeControl.Core.Services
@using System.Globalization
@{
    var monthDate = new DateOnly(Model.Monthly.Period.Year, Model.Monthly.Period.Month, 1);
    var monthTitle = CultureInfo.GetCultureInfo("nl-BE").TextInfo.ToTitleCase(
        monthDate.ToString("MMMM yyyy", CultureInfo.GetCultureInfo("nl-BE")));
    ViewData["Title"] = $"Urencontrole — {monthTitle}";
    var selected = Model.Cockpit.Selected;
    var startCorrection = selected is null ? null : DailyReviewDisplay.ReliableGpsCorrectionTime(selected.First);
    var endCorrection = selected is null ? null : DailyReviewDisplay.ReliableGpsCorrectionTime(selected.Last);
    string Tab(DailyReviewQueueView value) => Model.View == value ? "nav-link active" : "nav-link";
}

<div class="cockpit-heading">
    <div>
        <div class="text-uppercase small text-muted fw-semibold">Urencontrole</div>
        <h1 class="mb-1">@monthTitle</h1>
        <p class="text-muted mb-0">Controleer alleen de uitzonderingen waarvoor menselijke beoordeling nuttig is.</p>
    </div>
    <div class="cockpit-safety">Geen automatische correcties of personeelsconclusies</div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

<section class="card mb-3"><div class="card-body">
    <div class="d-flex flex-wrap justify-content-between gap-3 align-items-start">
        <div>
            <div><strong>Status:</strong> @(Model.Monthly.Period.Status switch { MonthlyReviewStatus.WaitingForData => "Wachten op gegevens", MonthlyReviewStatus.ReadyForReview => "Klaar voor controle", MonthlyReviewStatus.InReview => "Controle bezig", _ => "Afgesloten" })</div>
            <div class="small text-muted">Gegevens voorbereid: @(Model.Monthly.Period.PreparedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—") · Laatste update: @(Model.Monthly.Period.LastRefreshedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
            <div class="small text-muted">Laatste voertuigsynchronisatie: @(Model.Monthly.Period.LastVehicleSyncAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-secondary" asp-route-month="@Model.Monthly.PreviousMonth.Key">← Vorige maand</a>
            <a class="btn btn-sm btn-outline-secondary" asp-route-month="@Model.Monthly.NextMonth.Key">Volgende maand →</a>
            <a class="btn btn-sm btn-dark" asp-page-handler="Report" asp-route-month="@Model.Month">@(Model.Monthly.Period.Status == MonthlyReviewStatus.Finalized ? "Definitief rapport" : "Voorlopig rapport")</a>
        </div>
    </div>
    <div class="row g-2 mt-2 small">
        <div class="col">Te controleren: <strong>@Model.Cockpit.Counts.Open</strong></div>
        <div class="col">Beoordeeld/opvolging: <strong>@(Model.Cockpit.Counts.Completed + Model.Cockpit.Counts.ToReview)</strong></div>
        <div class="col">Data niet controleerbaar: <strong>@Model.Monthly.Summary.DataQualityCases</strong></div>
        <div class="col">Niet van toepassing: <strong>@Model.Monthly.Summary.NoTrackAndTrace</strong></div>
    </div>
    @if (Model.Monthly.Period.Status != MonthlyReviewStatus.Finalized && Model.Monthly.Period.Id != 0)
    {
        <div class="d-flex flex-wrap gap-2 mt-3">
            <form method="post" asp-page-handler="Refresh"><input type="hidden" name="Month" value="@Model.Month" /><button class="btn btn-sm btn-outline-primary">Vernieuw gegevens</button></form>
            <form method="post" asp-page-handler="Finalize"><input type="hidden" name="Month" value="@Model.Month" /><label class="small me-1"><input type="checkbox" name="ConfirmOpenCases" value="true" /> bewust afsluiten met open cases</label><button class="btn btn-sm btn-danger">Maand afsluiten</button></form>
        </div>
    }
</div></section>
@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<ul class="nav nav-tabs cockpit-tabs mb-3">
    <li class="nav-item"><a class="@Tab(DailyReviewQueueView.Open)" asp-route-view="Open" asp-route-month="@Model.Month">Te controleren <span>@Model.Cockpit.Counts.Open</span></a></li>
    <li class="nav-item"><a class="@Tab(DailyReviewQueueView.ToReview)" asp-route-view="ToReview" asp-route-month="@Model.Month">Opvolging <span>@Model.Cockpit.Counts.ToReview</span></a></li>
    <li class="nav-item"><a class="@Tab(DailyReviewQueueView.Completed)" asp-route-view="Completed" asp-route-month="@Model.Month">Afgehandeld <span>@Model.Cockpit.Counts.Completed</span></a></li>
    <li class="nav-item"><a class="@Tab(DailyReviewQueueView.DataQuality)" asp-route-view="DataQuality" asp-route-month="@Model.Month">Data niet controleerbaar <span>@Model.Cockpit.Counts.DataQuality</span></a></li>
    <li class="nav-item"><a class="@Tab(DailyReviewQueueView.NotApplicable)" asp-route-view="NotApplicable" asp-route-month="@Model.Month">Niet van toepassing <span>@Model.Cockpit.Counts.NotApplicable</span></a></li>
    <li class="nav-item"><a class="@Tab(DailyReviewQueueView.All)" asp-route-view="All" asp-route-month="@Model.Month">Alle <span>@Model.Cockpit.Counts.Total</span></a></li>
</ul>

<form method="get" class="cockpit-filters mb-3">
    <input type="hidden" asp-for="View" />
    <input type="hidden" asp-for="Month" />
    <div><label asp-for="Technician">Technieker</label><input class="form-control form-control-sm" asp-for="Technician" placeholder="Naam" /></div>
    <div><label asp-for="Date">Datum</label><input class="form-control form-control-sm" asp-for="Date" type="date" /></div>
    <div><label asp-for="Boundary">Moment</label><select class="form-select form-select-sm" asp-for="Boundary"><option value="All">Start en einde</option><option value="Start">Start</option><option value="End">Einde</option></select></div>
    <div><label asp-for="Evidence">Bewijs</label><select class="form-select form-select-sm" asp-for="Evidence"><option value="">Alle</option><option value="Complete">Volledig</option><option value="Partial">Gedeeltelijk</option><option value="Insufficient">Onvoldoende</option></select></div>
    <div><label asp-for="Sort">Sortering</label><select class="form-select form-select-sm" asp-for="Sort"><option value="LargestDifference">Grootste verschil</option><option value="DateAscending">Datum oplopend</option><option value="DateDescending">Datum aflopend</option><option value="Technician">Technieker</option></select></div>
    <div class="form-check align-self-end mb-1"><input class="form-check-input" asp-for="EscalatedOnly" /><label class="form-check-label" asp-for="EscalatedOnly">Alleen geëscaleerd</label></div>
    <button class="btn btn-sm btn-dark align-self-end" type="submit">Toepassen</button>
</form>

<div class="timecontrol-cockpit">
    <aside class="review-queue" aria-label="Review queue">
        <div class="queue-title"><strong>Review queue</strong><span>@Model.Cockpit.Cases.Count cases</span></div>
        <div class="queue-report-form">
            <div class="queue-items">
                @foreach (var item in Model.Cockpit.Cases)
                {
                    var active = selected?.CaseId == item.CaseId ? "active" : null;
                    <article class="queue-case @active">
                        <a asp-route-view="@Model.View" asp-route-technician="@Model.Technician" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")"
                           asp-route-boundary="@Model.Boundary" asp-route-evidence="@Model.Evidence" asp-route-sort="@Model.Sort"
                           asp-route-selectedCaseId="@item.CaseId" asp-route-month="@Model.Month" class="queue-case-link"
                           aria-current="@(active is null ? null : "true")">
                            <div class="queue-case-top"><strong>@item.Technician</strong><span>@item.Date.ToString("dd/MM")</span></div>
                            <div class="queue-customer">@item.Customer</div>
                            <div class="queue-facts">
                                <span>Start @DailyReviewDisplay.CompactDifference(item.First.SignedDifferenceMinutes)</span>
                                <span>Einde @DailyReviewDisplay.CompactDifference(item.Last.SignedDifferenceMinutes)</span>
                            </div>
                            <div class="queue-case-bottom"><span>@DailyReviewDisplay.Evidence(item.EvidenceLevel)</span><strong>@item.TotalPositiveMinutes.ToString("0") min</strong></div>
                        </a>
                    </article>
                }
            </div>
        </div>
    </aside>

    <main class="case-detail">
        @if (selected is null)
        {
            <div class="empty-detail"><h2>Geen case geselecteerd</h2><p>Pas de filters aan of kies een case uit de queue.</p></div>
        }
        else
        {
            <header class="case-header">
                <div><div class="small text-muted">@selected.Date.ToString("dddd d MMMM yyyy", new System.Globalization.CultureInfo("nl-BE"))</div><h2>@selected.Technician</h2><div class="case-site">@selected.Customer · @selected.Address</div></div>
                <div class="text-end"><span class="evidence-pill evidence-@selected.EvidenceLevel.ToString().ToLowerInvariant()">@DailyReviewDisplay.Evidence(selected.EvidenceLevel)</span><div class="mt-2 status-label">@DailyReviewDisplay.Status(selected.Decision.Status)</div></div>
            </header>

            <nav class="case-navigation" aria-label="Navigatie tussen reviewcases">
                @if (Model.PreviousCaseId is { } previousCaseId)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-route-view="@Model.View" asp-route-technician="@Model.Technician" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-boundary="@Model.Boundary" asp-route-evidence="@Model.Evidence" asp-route-sort="@Model.Sort" asp-route-selectedCaseId="@previousCaseId" asp-route-month="@Model.Month">← Vorige case</a>
                }
                else
                {
                    <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">← Vorige case</span>
                }
                @if (Model.NextCaseId is { } nextCaseId)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-route-view="@Model.View" asp-route-technician="@Model.Technician" asp-route-date="@Model.Date?.ToString("yyyy-MM-dd")" asp-route-boundary="@Model.Boundary" asp-route-evidence="@Model.Evidence" asp-route-sort="@Model.Sort" asp-route-selectedCaseId="@nextCaseId" asp-route-month="@Model.Month">Volgende case →</a>
                }
                else
                {
                    <span class="btn btn-sm btn-outline-secondary disabled" aria-disabled="true">Volgende case →</span>
                }
            </nav>

            @{
                var executedProposal = Model.CorrectionProposal is { Status: CorrectionProposalStatuses.Executed } executed
                    ? executed
                    : null;
            }
            <section class="boundary-grid">
                <article class="boundary-card">
                    <div class="boundary-kicker">Eerste klantprestatie</div><h3>Start van de werkdag</h3>
                    <dl>
                        @if (executedProposal?.ProposedStart is not null)
                        {
                            <dt>Oorspronkelijk geregistreerd</dt><dd>@executedProposal.OriginalStart.ToString("HH:mm")</dd>
                            <dt>Actueel in Plenion</dt><dd>@((executedProposal.ExecutedStart ?? executedProposal.ProposedStart)?.ToString("HH:mm"))</dd>
                        }
                        else
                        {
                            <dt>Geregistreerde start</dt><dd>@selected.First.PlenionTime.ToString("HH:mm")</dd>
                        }
                        <dt>GPS-aankomst op werklocatie</dt><dd>@DailyReviewDisplay.ApproximateTime(selected.First.GpsTime)</dd>
                    </dl>
                    <p class="boundary-result">@DailyReviewDisplay.Difference(selected.First)</p>
                    <div class="boundary-impact @DailyReviewDisplay.BoundaryImpactClass(selected.First)">@DailyReviewDisplay.BoundaryImpact(selected.First)</div>
                </article>
                <article class="boundary-card">
                    <div class="boundary-kicker">Laatste klantprestatie</div><h3>Einde van de werkdag</h3>
                    <dl>
                        <dt>GPS-vertrek van werklocatie</dt><dd>@DailyReviewDisplay.ApproximateTime(selected.Last.GpsTime)</dd>
                        @if (executedProposal?.ProposedEnd is not null)
                        {
                            <dt>Oorspronkelijk geregistreerd</dt><dd>@executedProposal.OriginalEnd.ToString("HH:mm")</dd>
                            <dt>Actueel in Plenion</dt><dd>@((executedProposal.ExecutedEnd ?? executedProposal.ProposedEnd)?.ToString("HH:mm"))</dd>
                        }
                        else
                        {
                            <dt>Geregistreerd einde</dt><dd>@selected.Last.PlenionTime.ToString("HH:mm")</dd>
                        }
                    </dl>
                    <p class="boundary-result">@DailyReviewDisplay.Difference(selected.Last)</p>
                    <div class="boundary-impact @DailyReviewDisplay.BoundaryImpactClass(selected.Last)">@DailyReviewDisplay.BoundaryImpact(selected.Last)</div>
                </article>
            </section>

            <section class="day-insight" aria-label="Daginzicht">
                <div><span>Startverschil</span><strong>@DailyReviewDisplay.CompactDifference(selected.First.SignedDifferenceMinutes)</strong></div>
                <div><span>Eindverschil</span><strong>@DailyReviewDisplay.CompactDifference(selected.Last.SignedDifferenceMinutes)</strong></div>
                <div><span>Bevestigd positief</span><strong>@selected.ConfirmedPositiveMinutes.ToString("0") min</strong></div>
                <p>@DailyReviewDisplay.DayInterpretation(selected)</p>
            </section>

            <section class="case-timeline" aria-label="Tijdlijn">
                <h3>Tijdlijn</h3>
                <div class="timeline-row"><time>@DailyReviewDisplay.ApproximateTime(selected.First.GpsTime)</time><span class="timeline-dot gps"></span><span>GPS-aankomst op eerste werklocatie</span></div>
                <div class="timeline-row"><time>@selected.First.PlenionTime.ToString("HH:mm")</time><span class="timeline-dot plenion"></span><span>Geregistreerde start eerste klantprestatie</span></div>
                <div class="timeline-work"><span>Klantwerk volgens de geregistreerde prestaties</span></div>
                <div class="timeline-row"><time>@DailyReviewDisplay.ApproximateTime(selected.Last.GpsTime)</time><span class="timeline-dot gps"></span><span>GPS-vertrek van laatste werklocatie</span></div>
                <div class="timeline-row"><time>@selected.Last.PlenionTime.ToString("HH:mm")</time><span class="timeline-dot plenion"></span><span>Geregistreerd einde laatste klantprestatie</span></div>
            </section>

            @if (selected.TripContext is { } tripContext && tripContext.DayTrips.Count > 0)
            {
                <section class="trip-context" aria-label="Ritcontext van deze dag">
                    <div class="trip-context-heading"><div><div class="boundary-kicker">PowerFleet dagcontext</div><h3>Ritten rond de klantboundaries</h3></div><span>@tripContext.DayTrips.Count ritten</span></div>
                    <div class="trip-context-grid">
                        <article class="trip-card">
                            <h4>Rit vóór eerste klantprestatie</h4>
                            @if (tripContext.TripBeforeFirstCustomer is { } beforeTrip)
                            {
                                <div class="trip-time">@beforeTrip.Start.ToString("HH:mm")–@beforeTrip.End.ToString("HH:mm") · @beforeTrip.DurationMinutes min</div>
                                <div class="trip-route"><span>@beforeTrip.StartAddress</span><span aria-hidden="true">→</span><strong>@beforeTrip.EndAddress</strong></div>
                                <div class="trip-meta">@DailyReviewDisplay.TripDistance(beforeTrip)</div>
                                @if (beforeTrip.IsFirstBoundaryArrivalTrip)
                                {
                                    <div class="trip-boundary-label">Deze rit eindigt bij de gebruikte GPS-aankomst.</div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">Geen voorafgaande rit beschikbaar in de bewaarde dagcontext.</p>
                            }
                        </article>
                        <article class="trip-card">
                            <h4>Rit na laatste klantprestatie</h4>
                            @if (tripContext.TripAfterLastCustomer is { } afterTrip)
                            {
                                <div class="trip-time">@afterTrip.Start.ToString("HH:mm")–@afterTrip.End.ToString("HH:mm") · @afterTrip.DurationMinutes min</div>
                                <div class="trip-route"><strong>@afterTrip.StartAddress</strong><span aria-hidden="true">→</span><span>@afterTrip.EndAddress</span></div>
                                <div class="trip-meta">@DailyReviewDisplay.TripDistance(afterTrip)</div>
                                @if (afterTrip.IsLastBoundaryDepartureTrip)
                                {
                                    <div class="trip-boundary-label">Deze rit start bij het gebruikte GPS-vertrek.</div>
                                }
                            }
                            else
                            {
                                <p class="text-muted mb-0">Geen volgende rit beschikbaar in de bewaarde dagcontext.</p>
                            }
                        </article>
                    </div>
                    <details class="day-trips">
                        <summary>Alle ritten van deze dag bekijken (@tripContext.DayTrips.Count)</summary>
                        <div class="table-responsive mt-3"><table class="table table-sm align-middle"><thead><tr><th>Tijd</th><th>Van</th><th>Naar</th><th>Afstand</th><th>Duur</th></tr></thead><tbody>
                        @foreach (var trip in tripContext.DayTrips)
                        {
                            <tr class="@(trip.IsFirstBoundaryArrivalTrip || trip.IsLastBoundaryDepartureTrip ? "trip-highlight" : null)"><td class="text-nowrap">@trip.Start.ToString("HH:mm")–@trip.End.ToString("HH:mm")</td><td>@trip.StartAddress</td><td>@trip.EndAddress</td><td class="text-nowrap">@DailyReviewDisplay.TripDistance(trip)</td><td class="text-nowrap">@trip.DurationMinutes min</td></tr>
                        }
                        </tbody></table></div>
                    </details>
                </section>
            }
            else
            {
                <div class="alert alert-light border mt-3">Geen ritcontext beschikbaar in de bewaarde evidence van deze dag.</div>
            }

            @if (selected.First.EvidenceType == "WorksiteSession" ||
                 selected.Last.EvidenceType == "WorksiteSession")
            {
                <div class="alert alert-light border">
                    GPS-aanwezigheid werd als één werfbezoek gereconstrueerd uit meerdere lokale voertuigbewegingen.
                </div>
            }

            @if (Model.CorrectionProposal is { Status: CorrectionProposalStatuses.Executed } proposal)
            {
                <section class="decision-panel correction-proposal" data-testid="correction-executed">
                    <h3>Correctie in Plenion</h3>
                    <div class="alert alert-success mb-0">
                        <strong>✓ Correctie uitgevoerd in Plenion</strong>
                        <div class="mt-2">
                            <strong>Start</strong><br />
                            @if (proposal.ProposedStart is not null)
                            {
                                <span>@proposal.OriginalStart.ToString("HH:mm") → @(proposal.ExecutedStart?.ToString("HH:mm") ?? proposal.ProposedStart.Value.ToString("HH:mm"))</span>
                            }
                            else
                            {
                                <span>ongewijzigd</span>
                            }
                        </div>
                        <div class="mt-2">
                            <strong>Einde</strong><br />
                            @if (proposal.ProposedEnd is not null)
                            {
                                <span>@proposal.OriginalEnd.ToString("HH:mm") → @(proposal.ExecutedEnd?.ToString("HH:mm") ?? proposal.ProposedEnd.Value.ToString("HH:mm"))</span>
                            }
                            else
                            {
                                <span>ongewijzigd</span>
                            }
                        </div>
                        <div class="mt-2">Uitgevoerd door: @proposal.ExecutedBy</div>
                        <div>Uitgevoerd op: @(proposal.ExecutedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</div>
                    </div>
                </section>
            }
            else if (Model.CorrectionProposal is { Status: CorrectionProposalStatuses.Conflict })
            {
                <section class="decision-panel correction-proposal" data-testid="correction-conflict">
                    <h3>Correctie in Plenion</h3>
                    <div class="alert alert-warning mb-0">
                        De registratie werd ondertussen gewijzigd in Plenion.
                        Vernieuw de gegevens en controleer deze case opnieuw.
                        <div class="small text-muted mt-1">Status: NeedsReReview / Conflict</div>
                        <div class="small mt-2">De mislukte poging blijft in de audit bewaard. Je kunt hieronder een nieuwe correctie proberen met een nieuw voorstel.</div>
                    </div>
                </section>
            }

            <section class="decision-panel">
                <h3>Adminbeoordeling</h3>
                @if (Model.Monthly.Period.Status == MonthlyReviewStatus.Finalized)
                {
                    <div class="alert alert-light border">Deze maand is afgesloten en alleen-lezen.</div>
                }
                else if (Model.CorrectionProposal?.Status == CorrectionProposalStatuses.Executed)
                {
                    <div class="alert alert-success mb-0">Deze case is afgehandeld met een uitgevoerde Plenion-correctie.</div>
                }
                else
                {
                    var startCorrectable = DailyReviewDisplay.CanCorrectBoundary(selected.First);
                    var endCorrectable = DailyReviewDisplay.CanCorrectBoundary(selected.Last);
                    var correctionActionable = DailyReviewDisplay.IsDirectCorrectionActionable(selected);
                    <form method="post"
                          asp-page-handler="Decision"
                          id="admin-review-form"
                          class="correction-execute-form"
                          data-testid="admin-review-form">
                        <input type="hidden" asp-for="CaseId" value="@selected.CaseId" />
                        <input type="hidden" asp-for="Month" />
                        <input type="hidden" asp-for="ConfirmCorrectionExecution" value="false" />
                        <div class="row g-3">
                            <div class="col-md-4">
                                <label class="form-label" asp-for="Reason">Reden</label>
                                <select class="form-select" asp-for="Reason" required>
                                    <option value="">Selecteer…</option>
                                    @foreach (var reason in Enum.GetValues<ReviewFeedbackReason>())
                                    {
                                        <option value="@reason">@DailyReviewDisplay.Reason(reason)</option>
                                    }
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label" asp-for="Notes">Notitie of vraag</label>
                                <textarea class="form-control" asp-for="Notes" rows="2"></textarea>
                            </div>
                        </div>

                        <section class="correction-in-plenion mt-4"
                                 data-testid="correction-in-plenion"
                                 data-original-start="@DailyReviewDisplay.RegisteredTime(selected.First.PlenionTime)"
                                 data-original-end="@DailyReviewDisplay.RegisteredTime(selected.Last.PlenionTime)"
                                 data-start-correctable="@(startCorrectable ? "true" : "false")"
                                 data-end-correctable="@(endCorrectable ? "true" : "false")"
                                 data-writes-enabled="@(Model.CorrectionAvailability.CanExecute ? "true" : "false")"
                                 data-technician="@selected.Technician"
                                 data-date="@selected.Date.ToString("dd/MM/yyyy")"
                                 data-customer="@(selected.First.Customer ?? selected.Customer)">
                            <h4 class="h5">Correctie in Plenion</h4>
                            @if (!correctionActionable)
                            {
                                <button type="button"
                                        class="btn btn-primary"
                                        data-testid="correction-execute-button"
                                        disabled>
                                    Correctie uitvoeren in Plenion
                                </button>
                                <div class="small text-muted mt-2" data-testid="correction-not-actionable">
                                    Geen betrouwbare GPS-correctie beschikbaar.
                                </div>
                            }
                            else
                            {
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label" asp-for="ProposedStartTime">Nieuwe start</label>
                                        <input class="form-control"
                                               asp-for="ProposedStartTime"
                                               type="time"
                                               disabled="@(!startCorrectable)"
                                               data-testid="proposed-start-time" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label" asp-for="ProposedEndTime">Nieuwe einde</label>
                                        <input class="form-control"
                                               asp-for="ProposedEndTime"
                                               type="time"
                                               disabled="@(!endCorrectable)"
                                               data-testid="proposed-end-time" />
                                    </div>
                                </div>
                                @if (startCorrection is not null || endCorrection is not null)
                                {
                                    <div class="quick-corrections mt-3" aria-label="Snelle GPS-correcties">
                                        @if (startCorrection is { } startTime)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary gps-correction"
                                                    data-target="ProposedStartTime"
                                                    data-time="@startTime.ToString("HH:mm")">
                                                Start aanpassen naar GPS @startTime.ToString("HH:mm")
                                            </button>
                                        }
                                        @if (endCorrection is { } endTime)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary gps-correction"
                                                    data-target="ProposedEndTime"
                                                    data-time="@endTime.ToString("HH:mm")">
                                                Einde aanpassen naar GPS @endTime.ToString("HH:mm")
                                            </button>
                                        }
                                        @if (startCorrection is { } bothStart && endCorrection is { } bothEnd)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-primary gps-correction-both"
                                                    data-start="@bothStart.ToString("HH:mm")"
                                                    data-end="@bothEnd.ToString("HH:mm")">
                                                Start + einde aanpassen naar GPS
                                            </button>
                                        }
                                    </div>
                                }
                                <div class="mt-3">
                                    <button type="submit"
                                            class="btn btn-primary"
                                            asp-page-handler="ExecuteCorrection"
                                            data-testid="correction-execute-button"
                                            id="correction-execute-button"
                                            disabled>
                                        Correctie uitvoeren in Plenion
                                    </button>
                                    <div class="small text-muted mt-2" data-testid="correction-execute-hint">
                                        Kies eerst een nieuwe start- en/of eindtijd.
                                    </div>
                                    @if (!Model.CorrectionAvailability.CanExecute)
                                    {
                                        <div class="small text-muted mt-2" data-testid="correction-writes-disabled">
                                            @Model.CorrectionAvailability.Message
                                        </div>
                                    }
                                </div>
                                <p class="small text-muted mt-2 mb-0">
                                    Snelle GPS-correcties vullen alleen Nieuwe start/einde in. Uitvoeren vereist een afzonderlijke bevestiging en schrijft pas daarna naar Plenion.
                                </p>
                            }
                        </section>

                        <div class="decision-actions mt-4">
                            <button class="btn btn-outline-success" name="decision" value="ResolvedNoAction">Geen probleem</button>
                            <button class="btn btn-outline-primary" name="decision" value="PendingCorrection">Administratieve fout</button>
                            <button class="btn btn-outline-warning" name="decision" value="AwaitingExplanation">Uitleg nodig</button>
                            <button class="btn btn-outline-danger" name="decision" value="EscalatedForManagementReview">Manueel escaleren</button>
                        </div>
                    </form>
                }
            </section>

            <details class="review-details"><summary>Recente controles</summary><div class="table-responsive"><table class="table table-sm mt-3"><thead><tr><th>Datum</th><th>Klant</th><th>Startverschil</th><th>Eindverschil</th><th>Bewijs</th><th>Adminbeslissing</th></tr></thead><tbody>@foreach(var recent in Model.Cockpit.RecentCases){<tr><td><a asp-route-view="All" asp-route-month="@Model.Month" asp-route-selectedCaseId="@recent.CaseId">@recent.Date.ToString("dd/MM/yyyy")</a></td><td>@recent.Customer</td><td>@DailyReviewDisplay.CompactDifference(recent.First.SignedDifferenceMinutes)</td><td>@DailyReviewDisplay.CompactDifference(recent.Last.SignedDifferenceMinutes)</td><td>@DailyReviewDisplay.Evidence(recent.EvidenceLevel)</td><td>@DailyReviewDisplay.Status(recent.Decision.Status)</td></tr>}</tbody></table></div></details>

            <details class="review-details"><summary>Technische details</summary><dl class="technical-grid mt-3"><dt>Case ID</dt><dd class="font-monospace">@selected.CaseId</dd><dt>Algoritmeversie</dt><dd>@selected.AlgorithmVersion</dd><dt>Start — originele tijd</dt><dd>@selected.First.PlenionTime.ToString("O")</dd><dt>Start — GPS-tijd</dt><dd>@(selected.First.GpsTime?.ToString("O") ?? "null")</dd><dt>Start — evidence/reconstructie</dt><dd>@selected.First.EvidenceType — @selected.First.TechnicalReason</dd><dt>Start — interne status/score/afstand</dt><dd>@selected.First.MatcherStatus / @(selected.First.Score?.ToString("0.0") ?? "—") / @(selected.First.DistanceMeters?.ToString("0.0") ?? "—") m</dd><dt>Einde — originele tijd</dt><dd>@selected.Last.PlenionTime.ToString("O")</dd><dt>Einde — GPS-tijd</dt><dd>@(selected.Last.GpsTime?.ToString("O") ?? "null")</dd><dt>Einde — evidence/reconstructie</dt><dd>@selected.Last.EvidenceType — @selected.Last.TechnicalReason</dd><dt>Einde — interne status/score/afstand</dt><dd>@selected.Last.MatcherStatus / @(selected.Last.Score?.ToString("0.0") ?? "—") / @(selected.Last.DistanceMeters?.ToString("0.0") ?? "—") m</dd></dl></details>

            <details class="review-details"><summary>Beslissingshistoriek (@Model.AuditTrail.Count)</summary>@if(Model.AuditTrail.Count==0){<p class="text-muted mt-3">Nog geen adminbeslissingen.</p>}else{<div class="table-responsive"><table class="table table-sm mt-3"><thead><tr><th>Tijdstip</th><th>Reviewer</th><th>Beslissing</th><th>Reden</th><th>Notitie</th></tr></thead><tbody>@foreach(var action in Model.AuditTrail){<tr><td>@action.ReviewedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td>@action.ReviewedBy</td><td>@action.Decision</td><td>@(action.DecisionReason ?? "—")</td><td>@(action.Notes ?? "—")</td></tr>}</tbody></table></div>}</details>
        }
    </main>
</div>

@section Scripts {
    <script>
        (() => {
            const section = document.querySelector('[data-testid="correction-in-plenion"]');
            const form = document.getElementById('admin-review-form');
            const executeButton = document.getElementById('correction-execute-button');
            const hint = document.querySelector('[data-testid="correction-execute-hint"]');
            const confirmField = form?.querySelector('[name="ConfirmCorrectionExecution"]');
            const reason = document.getElementById('Reason');
            const startInput = document.getElementById('ProposedStartTime');
            const endInput = document.getElementById('ProposedEndTime');

            const applyTime = (target, value) => {
                const input = document.getElementById(target);
                if (input && !input.disabled) input.value = value;
                if (reason && !reason.value) reason.value = 'AdministrativeEntryError';
                refreshExecuteState();
            };

            document.querySelectorAll('.gps-correction').forEach(button => {
                button.addEventListener('click', () => applyTime(button.dataset.target, button.dataset.time));
            });
            document.querySelectorAll('.gps-correction-both').forEach(button => {
                button.addEventListener('click', () => {
                    applyTime('ProposedStartTime', button.dataset.start);
                    applyTime('ProposedEndTime', button.dataset.end);
                });
            });

            const refreshExecuteState = () => {
                if (!section || !executeButton || !hint) return;
                const writesEnabled = section.dataset.writesEnabled === 'true';
                const startOk = section.dataset.startCorrectable === 'true';
                const endOk = section.dataset.endCorrectable === 'true';
                const originalStart = section.dataset.originalStart;
                const originalEnd = section.dataset.originalEnd;
                const startValue = startInput && !startInput.disabled ? startInput.value : '';
                const endValue = endInput && !endInput.disabled ? endInput.value : '';
                const startChanged = startOk && !!startValue && startValue !== originalStart;
                const endChanged = endOk && !!endValue && endValue !== originalEnd;
                const hasChange = startChanged || endChanged;
                const hasReason = !!(reason && reason.value);
                const canEnable = writesEnabled && hasChange && hasReason;
                executeButton.disabled = !canEnable;

                if (!hasChange) {
                    hint.textContent = 'Kies eerst een nieuwe start- en/of eindtijd.';
                } else if (!hasReason) {
                    hint.textContent = 'Selecteer eerst een reden.';
                } else if (!writesEnabled) {
                    hint.textContent = 'Plenion-correcties zijn momenteel uitgeschakeld.';
                } else {
                    hint.textContent = 'Klaar om te bevestigen en uit te voeren in Plenion.';
                }

                const startLine = startChanged
                    ? `${originalStart} → ${startValue}`
                    : 'ongewijzigd';
                const endLine = endChanged
                    ? `${originalEnd} → ${endValue}`
                    : 'ongewijzigd';
                const reasonLabel = reason?.selectedOptions?.[0]?.textContent?.trim() || reason?.value || '';
                executeButton.setAttribute('data-confirm',
                    `Correctie uitvoeren in Plenion?\n\n` +
                    `${section.dataset.technician}\n` +
                    `${section.dataset.date}\n` +
                    `${section.dataset.customer}\n\n` +
                    `Start:\n${startLine}\n\n` +
                    `Einde:\n${endLine}\n\n` +
                    `Reden:\n${reasonLabel}\n\n` +
                    `OK = Correctie uitvoeren, Annuleren = stoppen.`);
            };

            [reason, startInput, endInput].forEach(el => {
                el?.addEventListener('input', refreshExecuteState);
                el?.addEventListener('change', refreshExecuteState);
            });

            executeButton?.addEventListener('click', () => {
                if (confirmField) confirmField.value = 'true';
            });

            form?.querySelectorAll('.decision-actions button[type="submit"], .decision-actions button[name="decision"]').forEach(button => {
                button.addEventListener('click', () => {
                    if (confirmField) confirmField.value = 'false';
                });
            });

            refreshExecuteState();
        })();
    </script>
}
