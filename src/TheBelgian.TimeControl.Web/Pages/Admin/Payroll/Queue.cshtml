@page "/Admin/Payroll/{year:int}/{month:int}/Queue"
@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.QueueModel
@using TheBelgian.TimeControl.Core.Payroll.Findings
@using TheBelgian.TimeControl.Core.Payroll.Review
@{
    ViewData["Title"] = $"Payroll opvolging {Model.Month:00}/{Model.Year}";
    var queue = Model.Queue;
    var admin = queue?.AdminSummary;
    var review = queue?.ReviewSummary;
    string GuidedHref(PayrollReviewCategory category) =>
        Url.Page("./Guided", new { year = Model.Year, month = Model.Month, category })!;
    string CategoryHref(PayrollReviewCategory category) =>
        Url.Page("./Queue", new
        {
            year = Model.Year,
            month = Model.Month,
            Category = category,
            Search = Model.Search,
            Scope = Model.Scope,
            Sort = Model.Sort,
            ListMode = true,
        })!;
    string ScopeHref(PayrollReviewQueueScope scope) =>
        Url.Page("./Queue", new
        {
            year = Model.Year,
            month = Model.Month,
            Category = Model.Category,
            Search = Model.Search,
            Sort = Model.Sort,
            Scope = scope,
            ListMode = Model.ListMode,
        })!;
    var cards = new[]
    {
        PayrollReviewCategory.Project300,
        PayrollReviewCategory.Project200,
        PayrollReviewCategory.Project100,
        PayrollReviewCategory.Standby,
        PayrollReviewCategory.Overlap,
        PayrollReviewCategory.MissingPerformance,
    };
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <div class="text-uppercase small text-muted fw-semibold">Payroll shadow</div>
        <h1 class="h3 mb-1">Opvolging @Model.Month.ToString("00")/@Model.Year</h1>
        <p class="text-muted mb-0">Begeleide categoriecontrole: begrijp → beslis → volgende.</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary" asp-page="./Month" asp-route-year="@Model.Year" asp-route-month="@Model.Month">← Maand</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }

@if (queue is null || admin is null || review is null)
{
    <div class="alert alert-warning">Shadow-maand niet gevonden.</div>
}
else
{
    <div class="row g-2 mb-3">
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Open admin-cases</div><div class="fs-5 fw-semibold">@admin.Open</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Opvolging</div><div class="fs-5 fw-semibold text-warning">@admin.NeedsFollowUp</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">Afgehandeld</div><div class="fs-5 fw-semibold text-success">@admin.Completed</div></div></div>
        <div class="col-6 col-md-3"><div class="border rounded p-2"><div class="small text-muted">High open</div><div class="fs-5 fw-semibold text-danger">@admin.HighOpen</div></div></div>
    </div>
    <p class="small text-muted mb-3">
        @review.IncludedEmployees medewerkers in payrollcontrole
        · ReviewCases @admin.ReviewCasesTotal
        · AdminCases @admin.AdminCasesTotal
        · raw findings zie technische samenvatting per categorie
    </p>

    <div class="row g-2 mb-4">
        @foreach (var cat in cards)
        {
            var adminTotal = admin.AdminCasesByCategory.GetValueOrDefault(cat);
            var open = admin.UnresolvedAdminByCategory.GetValueOrDefault(cat);
            var follow = admin.FollowUpAdminByCategory.GetValueOrDefault(cat);
            var done = admin.CompletedAdminByCategory.GetValueOrDefault(cat);
            var raw = admin.ReviewCasesByCategory.GetValueOrDefault(cat);
            var active = Model.Category == cat ? "border-primary" : "";
            <div class="col-12 col-md-6 col-xl-4">
                <div class="card h-100 @active">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div>
                                <div class="fw-semibold">@PayrollReviewCategories.DisplayName(cat)</div>
                                <div class="small text-muted">@raw review cases · @adminTotal admin cases</div>
                            </div>
                        </div>
                        <div class="small mt-2 mb-3">
                            <span class="me-2">@open te beoordelen</span>
                            <span class="me-2 text-warning">@follow opvolging</span>
                            <span class="text-success">@done afgehandeld</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            @if (open + follow > 0)
                            {
                                <a class="btn btn-sm btn-primary" href="@GuidedHref(cat)">Start controle</a>
                            }
                            else
                            {
                                <button class="btn btn-sm btn-outline-secondary" type="button" disabled>Start controle</button>
                            }
                            <a class="btn btn-sm btn-outline-secondary" href="@CategoryHref(cat)">Lijst</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.ListMode || Model.Category != PayrollReviewCategory.All || !string.IsNullOrWhiteSpace(Model.Search))
    {
        <div class="btn-group btn-group-sm mb-3" role="group">
            <a class="btn @(Model.Scope == PayrollReviewQueueScope.Open ? "btn-dark" : "btn-outline-secondary")" href="@ScopeHref(PayrollReviewQueueScope.Open)">Open</a>
            <a class="btn @(Model.Scope == PayrollReviewQueueScope.Closed ? "btn-dark" : "btn-outline-secondary")" href="@ScopeHref(PayrollReviewQueueScope.Closed)">Afgehandeld</a>
            <a class="btn @(Model.Scope == PayrollReviewQueueScope.All ? "btn-dark" : "btn-outline-secondary")" href="@ScopeHref(PayrollReviewQueueScope.All)">Alles</a>
        </div>

        <form method="get" class="card mb-3">
            <div class="card-body row g-2 align-items-end">
                <input type="hidden" name="year" value="@Model.Year" />
                <input type="hidden" name="month" value="@Model.Month" />
                <input type="hidden" name="ListMode" value="true" />
                <input type="hidden" asp-for="Category" />
                <input type="hidden" asp-for="Scope" />
                <div class="col-12 col-lg-6">
                    <label class="form-label" asp-for="Search">Zoeken</label>
                    <input class="form-control" asp-for="Search" placeholder="Zoek medewerker, bon, project, datum..." />
                </div>
                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label" asp-for="Sort">Sortering</label>
                    <select class="form-select form-select-sm" asp-for="Sort">
                        <option value="default">Standaard</option>
                        <option value="datum">Datum</option>
                        <option value="medewerker">Medewerker A-Z</option>
                        <option value="categorie">Categorie</option>
                        <option value="ernst">Ernst</option>
                    </select>
                </div>
                <div class="col-auto"><button class="btn btn-sm btn-outline-secondary" type="submit">Toepassen</button></div>
            </div>
        </form>

        <p class="small text-muted mb-2">Toont <strong>@queue.AdminCases.Count</strong> admin-cases. Bulk alleen voor veilige categorieën (niet wachtdienst / sterk missing).</p>

        <form method="post" asp-page-handler="Bulk" id="bulk-form" onsubmit="return confirmBulk();">
            <input type="hidden" name="Category" value="@Model.Category" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="Sort" value="@Model.Sort" />
            <input type="hidden" name="Scope" value="@Model.Scope" />
            <input type="hidden" name="ListMode" value="true" />
            <div class="card mb-3">
                <div class="card-body d-flex flex-wrap gap-2 align-items-end">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="select-visible">Selecteer zichtbare (bulk-toegelaten)</button>
                    <div class="ms-auto d-flex flex-wrap gap-2 align-items-end">
                        <input class="form-control form-control-sm" name="Comment" style="min-width:12rem" placeholder="Bulk-reden" />
                        <select class="form-select form-select-sm" name="BulkDecisionCode" style="min-width:12rem">
                            <option value="">— bulk-beslissing —</option>
                            @if (Model.Category is PayrollReviewCategory.Project300 or PayrollReviewCategory.All)
                            {
                                <option value="@PayrollGuidedDecisionCodes.P300WorkValid">300: Werk was terecht</option>
                                <option value="@PayrollGuidedDecisionCodes.P300PlanningMissing">300: Planning ontbreekt</option>
                            }
                            @if (Model.Category is PayrollReviewCategory.Project200 or PayrollReviewCategory.All)
                            {
                                <option value="@PayrollGuidedDecisionCodes.P200Valid">200: Correct</option>
                                <option value="@PayrollGuidedDecisionCodes.P200PlanningMissing">200: Planning ontbreekt</option>
                            }
                        </select>
                        <button class="btn btn-sm btn-warning" type="submit">Bulk toepassen</button>
                    </div>
                </div>
            </div>
        </form>

        <div class="d-none d-lg-block table-responsive card mb-3">
            <table class="table table-sm align-middle mb-0">
                <thead>
                <tr>
                    <th style="width:2rem"></th>
                    <th>Datum</th>
                    <th>Medewerker</th>
                    <th>Issue</th>
                    <th>Kern</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var item in queue.AdminCases)
                {
                    <tr>
                        <td>
                            @if (item.AllowsBulkDisposition)
                            {
                                <input class="form-check-input case-check" type="checkbox" name="SelectedAdminCaseKeys" value="@item.AdminCaseKey" form="bulk-form" />
                            }
                        </td>
                        <td>@item.Date.ToString("dd/MM")</td>
                        <td>
                            <div class="fw-semibold">@(item.DisplayName ?? item.ResourceId)</div>
                            @if (!string.IsNullOrWhiteSpace(item.BonNr) || !string.IsNullOrWhiteSpace(item.ProjectId))
                            {
                                <div class="small text-muted">@(item.BonNr ?? item.ProjectId)</div>
                            }
                        </td>
                        <td>
                            <div>@item.IssueSummary</div>
                            <div class="small text-muted">@PayrollGuidedDecisions.AdminStatusLabel(item.WorkflowStatus)</div>
                        </td>
                        <td class="small">@(item.KeyFact ?? item.BookedSummary)</td>
                        <td class="text-nowrap">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-page="./Guided"
                               asp-route-year="@Model.Year"
                               asp-route-month="@Model.Month"
                               asp-route-category="@item.Category"
                               asp-route-Focus="@item.AdminCaseKey">Review</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="d-lg-none vstack gap-2 mb-3">
            @foreach (var item in queue.AdminCases)
            {
                <div class="card">
                    <div class="card-body">
                        <div class="d-flex gap-2">
                            @if (item.AllowsBulkDisposition)
                            {
                                <input class="form-check-input case-check mt-1" type="checkbox" name="SelectedAdminCaseKeys" value="@item.AdminCaseKey" form="bulk-form" />
                            }
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@(item.DisplayName ?? item.ResourceId)</div>
                                <div class="small text-muted">@item.Date.ToString("dd/MM/yyyy")</div>
                                <p class="mb-1 mt-1">@item.IssueSummary</p>
                                <p class="small mb-2">@(item.KeyFact ?? item.BookedSummary)</p>
                                <a class="btn btn-sm btn-outline-primary"
                                   asp-page="./Guided"
                                   asp-route-year="@Model.Year"
                                   asp-route-month="@Model.Month"
                                   asp-route-category="@item.Category"
                                   asp-route-Focus="@item.AdminCaseKey">Review</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (queue.AdminCases.Count == 0)
        {
            <div class="alert alert-secondary">Geen admin-cases voor deze filters.</div>
        }
    }
}

@section Scripts {
<script>
function confirmBulk() {
  const checked = document.querySelectorAll('.case-check:checked');
  if (!checked.length) { alert('Selecteer minstens één zichtbare case.'); return false; }
  return confirm(checked.length + ' controles worden bijgewerkt.');
}
document.getElementById('select-visible')?.addEventListener('click', () => {
  document.querySelectorAll('.case-check').forEach(cb => { cb.checked = true; });
});
</script>
}
