@page "/Admin/Payroll/ActionConfirm"
@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.ActionConfirmModel
@using TheBelgian.TimeControl.Core.Payroll.Actions
@using TheBelgian.TimeControl.Core.Payroll.Findings
@using TheBelgian.TimeControl.Core.Payroll.Review
@{
    ViewData["Title"] = "Voorstel controleren";
    var view = Model.View;
    var isDelete = view?.ActionType == PayrollProposedActionType.DeleteExistingPerformance;
    var isCreate = view?.ActionType == PayrollProposedActionType.CreateMissingPerformance;
    var isAdjust = view?.ActionType == PayrollProposedActionType.AdjustExistingPerformanceTime;
    var canEditCreate = isCreate
        && view is not null
        && view.Status is not PayrollProposedActionStatus.Applied
            and not PayrollProposedActionStatus.Executing
            and not PayrollProposedActionStatus.Cancelled;
    MissingTechnicianAdminExplanation? createExpl = null;
    if (isCreate && view is not null)
    {
        var travel = PayrollIntelligenceWorkbenchBuilder.ParseTravelMode(view.Evidence.Evidence);
        TimeOnly? start = view.CreateProposal is null ? null : TimeOnly.FromTimeSpan(view.CreateProposal.Start.TimeOfDay);
        TimeOnly? end = view.CreateProposal is null ? null : TimeOnly.FromTimeSpan(view.CreateProposal.End.TimeOfDay);
        TimeOnly? peerStart = null;
        TimeOnly? peerEnd = null;
        var peerTok = System.Text.RegularExpressions.Regex.Match(
            view.Evidence.Evidence ?? string.Empty,
            @"peers=\[[^\s#]+#\d+:(\d{2}:\d{2})-(\d{2}:\d{2})");
        if (peerTok.Success)
        {
            _ = TimeOnly.TryParse(peerTok.Groups[1].Value, out var ps);
            _ = TimeOnly.TryParse(peerTok.Groups[2].Value, out var pe);
            peerStart = ps;
            peerEnd = pe;
        }

        createExpl = MissingTechnicianAdminExplainability.Build(
            view.Evidence.Evidence,
            peerResourceId: null,
            peerDisplayName: null,
            peerStart,
            peerEnd,
            start,
            end,
            view.CreateProposal?.Hours,
            view.CreateProposal?.ProjectId ?? view.Evidence.SuggestedProjectId,
            view.CreateProposal?.BonNr ?? view.Evidence.SuggestedBonNr,
            view.CreateProposal?.MainTaskId,
            travel,
            canProposeCreate: true);
    }
}

@if (!string.IsNullOrWhiteSpace(Model.Error))
{
    <div class="alert alert-danger">
        <strong>AANMAKEN NIET GELUKT</strong>
        <div class="mt-1">@Model.Error</div>
        @if (view?.CreateProposal is not null)
        {
            <div class="mt-2 small">
                Uw voorstel is bewaard:
                @view.CreateProposal.Start.ToString("HH:mm")–@view.CreateProposal.End.ToString("HH:mm")
                · Project @view.CreateProposal.ProjectId
                · BON @(view.CreateProposal.BonNr ?? "—")
                · Taak @view.CreateProposal.MainTaskId
            </div>
            <div class="small text-muted mt-1">ActionId @view.ActionId · Status @PayrollActionEligibility.UiStatusLabel(view.Status)</div>
        }
    </div>
}
@if (!string.IsNullOrWhiteSpace(Model.Message))
{
    <div class="alert alert-success">@Model.Message</div>
}

@if (view is null)
{
    <p>Voorstel niet gevonden.</p>
}
else
{
    <p class="mb-2">
        <a asp-page="./Employee" asp-route-year="@view.Year" asp-route-month="@view.Month" asp-route-resourceId="@view.ResourceId">← Terug naar medewerker</a>
    </p>

    @if (isDelete)
    {
        <h1 class="h4 mb-3 text-danger">Prestatie definitief verwijderen uit Plenion</h1>
        <div class="alert alert-danger">
            <strong>Destructieve actie.</strong>
            Alleen deze urenprestatie wordt verwijderd.
            De bon, het project en andere prestaties blijven bestaan.
            Geen cascade. Geen automatische uitvoering — expliciete goedkeuring is verplicht.
        </div>
    }
    else if (isCreate)
    {
        <h1 class="h4 mb-3">Prestatie aanmaken in Plenion</h1>
        <div class="alert alert-warning">
            <strong>Er wordt een nieuwe urenprestatie in Plenion aangemaakt.</strong>
            Geen automatische uitvoering — expliciete goedkeuring is verplicht.
        </div>
    }
    else if (isAdjust)
    {
        <h1 class="h4 mb-3">Prestatie aanpassen in Plenion</h1>
        <div class="alert alert-warning">
            <strong>De VAN/TOT van een bestaande urenprestatie wordt in Plenion aangepast.</strong>
            Geen automatische uitvoering — expliciete goedkeuring is verplicht.
        </div>
    }
    else
    {
        <h1 class="h4 mb-3">Voorstel controleren</h1>
        <div class="alert alert-warning">
            <strong>Deze actie wijzigt Plenion.</strong>
            Geen automatische uitvoering — expliciete goedkeuring is verplicht.
        </div>
    }

    <div class="mb-3">
        <div><strong>Medewerker:</strong> @(view.DisplayName ?? view.ResourceId)</div>
        <div><strong>Status:</strong> @PayrollActionEligibility.UiStatusLabel(view.Status)</div>
        @if (view.Status == PayrollProposedActionStatus.Stale)
        {
            <div class="alert alert-secondary py-2 mt-2">
                <strong>DIT VOORSTEL IS INTUSSEN GEWIJZIGD</strong>
                <div class="small mt-1">Oud voorstel — niet meer uitvoerbaar.</div>
                @if (view.CreateProposal is not null)
                {
                    <div class="small">Vorige: @view.CreateProposal.Start.ToString("HH:mm")–@view.CreateProposal.End.ToString("HH:mm")</div>
                }
                <a class="btn btn-sm btn-outline-primary mt-2"
                   asp-page="./MissingTechnicianWorkbench"
                   asp-route-year="@view.Year"
                   asp-route-month="@view.Month"
                   asp-route-Scope="Open">Nieuw voorstel bekijken</a>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(view.BlockReason))
        {
            <div class="text-danger"><strong>Reden:</strong> @view.BlockReason</div>
        }
        @if (!string.IsNullOrWhiteSpace(view.ExecutionGateMessage))
        {
            <div class="text-muted">@view.ExecutionGateMessage</div>
        }
    </div>

    @if (isCreate && createExpl is not null)
    {
        <section class="border rounded p-3 mb-3">
            <h2 class="h6 text-uppercase">Waarom</h2>
            <ul class="mb-2">
                @foreach (var bullet in createExpl.WhyBullets)
                {
                    <li>@bullet</li>
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(createExpl.PlanningInterval))
            {
                <div class="small">Planning: @createExpl.PlanningInterval</div>
            }
            @if (!string.IsNullOrWhiteSpace(createExpl.PeerInterval))
            {
                <div class="small">Collega: @createExpl.PeerInterval</div>
            }
            @if (!string.IsNullOrWhiteSpace(createExpl.ProposalInterval))
            {
                <div class="small">Eigen Track &amp; Trace / voorstel: @createExpl.ProposalInterval</div>
            }
            @if (!string.IsNullOrWhiteSpace(createExpl.HqExcursionNl))
            {
                <div class="small mt-1">@createExpl.HqExcursionNl</div>
            }
            @if (!string.IsNullOrWhiteSpace(createExpl.AllocationReviewNl))
            {
                <div class="small text-warning-emphasis mt-1">@createExpl.AllocationReviewNl</div>
            }
        </section>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <section class="border rounded p-3 h-100">
                <h2 class="h6">@(isCreate ? "Bewijs" : isDelete ? "Huidige prestatie" : "Huidig / bron")</h2>
                @if (view.DeleteProposal is not null)
                {
                    <p class="mb-1"><strong>@(view.DisplayName ?? view.ResourceId)</strong></p>
                    <p class="mb-1">@PayrollDisplayFormatting.DateWithWeekday(view.DeleteProposal.Date)</p>
                    <p class="mb-1">
                        @view.DeleteProposal.CurrentStart.ToString("HH:mm")–@view.DeleteProposal.CurrentEnd.ToString("HH:mm")
                        · @view.DeleteProposal.AtlHours.ToString("0.##", System.Globalization.CultureInfo.GetCultureInfo("nl-BE")) u
                    </p>
                    <p class="mb-1">
                        Project @(string.IsNullOrWhiteSpace(view.DeleteProposal.ProjectLabel)
                            || view.DeleteProposal.ProjectLabel.StartsWith("BON ", StringComparison.Ordinal)
                            || string.Equals(view.DeleteProposal.ProjectLabel, view.DeleteProposal.BonNr, StringComparison.Ordinal)
                            ? "300"
                            : view.DeleteProposal.ProjectLabel)
                    </p>
                    <p class="mb-1">BON @(view.DeleteProposal.BonNr ?? "—")</p>
                    <p class="mb-1">Taak: @(string.IsNullOrWhiteSpace(view.DeleteProposal.ExpectedActivityType) ? "—" : view.DeleteProposal.ExpectedActivityType)</p>
                    @if (!string.IsNullOrWhiteSpace(view.DeleteProposal.PrestOmschr))
                    {
                        <p class="mb-1">Omschrijving: @view.DeleteProposal.PrestOmschr</p>
                    }
                    <p class="mb-0 small text-muted">PerformanceId @view.DeleteProposal.PerformanceId@(view.DeleteProposal.ExpectedMainTaskExternalId is long taskId ? $" · IDHFDTAAK {taskId}" : "")</p>
                }
                else if (isCreate)
                {
                    <p class="mb-1"><strong>ONTBREKENDE PRESTATIE</strong></p>
                    <p class="mb-1">Nog niet geregistreerd in Plenion</p>
                    @if (createExpl is not null)
                    {
                        <p class="mb-1 small">Tijdsvoorstel op basis van: @createExpl.TimingSourcePrimary</p>
                        @if (!string.IsNullOrWhiteSpace(createExpl.TimingSourceSupporting))
                        {
                            <p class="mb-1 small text-muted">Ondersteund door: @createExpl.TimingSourceSupporting</p>
                        }
                        <p class="mb-0 small text-muted">@createExpl.ReadinessNl</p>
                    }
                    <details class="mt-2">
                        <summary class="small text-muted">Technische details</summary>
                        <p class="mb-1 small">@PayrollReviewLabels.MissingTechnicianEvidence(view.Evidence.GpsClassification)</p>
                        <p class="mb-0 small text-muted">@view.Evidence.Evidence</p>
                    </details>
                }
                else
                {
                    <p class="mb-1"><strong>@view.Evidence.Title</strong></p>
                    <p class="mb-1 small">@view.Evidence.Description</p>
                    @if (view.AdjustProposal is not null)
                    {
                        <p class="mb-0 small">
                            Start: @view.AdjustProposal.CurrentStart.ToString("HH:mm") ·
                            Einde: @view.AdjustProposal.CurrentEnd.ToString("HH:mm") ·
                            Prestatie #@view.AdjustProposal.PerformanceId
                        </p>
                    }
                }
            </section>
        </div>
        <div class="col-md-6">
            <section class="border rounded p-3 h-100 @(isDelete ? "border-danger" : "")">
                <h2 class="h6">@(isCreate ? "Aan te maken" : "Voorstel")</h2>
                @if (view.DeleteProposal is not null)
                {
                    <p class="mb-1"><strong>Prestatie definitief verwijderen</strong></p>
                    <ul class="small mb-0">
                        <li>Datum: @PayrollDisplayFormatting.DateWithWeekday(view.DeleteProposal.Date)</li>
                        <li>VAN–TOT: @view.DeleteProposal.CurrentStart.ToString("HH:mm")–@view.DeleteProposal.CurrentEnd.ToString("HH:mm")</li>
                        <li>Uren: @view.DeleteProposal.AtlHours.ToString("0.##")</li>
                        <li>BON: @(view.DeleteProposal.BonNr ?? "—")</li>
                        @if (!string.IsNullOrWhiteSpace(view.DeleteProposal.PrestOmschr))
                        {
                            <li>Omschrijving: @view.DeleteProposal.PrestOmschr</li>
                        }
                    </ul>
                }
                else if (view.CreateProposal is not null)
                {
                    var cp = view.CreateProposal;
                    var gross = cp.GrossHours > 0
                        ? cp.GrossHours
                        : Math.Round((decimal)(cp.End - cp.Start).TotalHours, 4);
                    <p class="mb-1 text-uppercase small text-muted fw-semibold">Aan te maken</p>
                    <p class="mb-1 fs-5 fw-semibold">@cp.Start.ToString("HH:mm")–@cp.End.ToString("HH:mm")</p>
                    <ul class="small mb-2">
                        <li>Bruto uren: @gross.ToString("0.##") u</li>
                        <li>Pauze: @((int)cp.Pause.TotalMinutes) min</li>
                        <li>Netto ATL: @cp.Hours.ToString("0.####") u</li>
                        <li>Project: @cp.ProjectId</li>
                        <li>BON: @(cp.BonNr ?? "—")</li>
                        <li>Taak: @cp.MainTaskId</li>
                    </ul>
                    <div class="small mb-1">
                        <span class="tc-source-badge @PayrollPrimaryTimingSourceLabels.Css(cp.PrimaryTimingSource)">
                            @PayrollPrimaryTimingSourceLabels.Nl(cp.PrimaryTimingSource)
                        </span>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(cp.SupportingEvidenceNl))
                    {
                        <div class="small text-muted mb-2">Ondersteund door: @cp.SupportingEvidenceNl</div>
                    }
                    <div class="small border-top pt-2">
                        <div><strong>Pauzecontrole:</strong> @(cp.PauseExplanationNl ?? "—")</div>
                        <div><strong>Overlapcontrole:</strong> @(cp.OverlapExplanationNl ?? "—")</div>
                    </div>
                }
                else if (view.AdjustProposal is not null)
                {
                    var ap = view.AdjustProposal;
                    <p class="mb-1 text-uppercase small text-muted fw-semibold">Prestatie aanpassen</p>
                    <ul class="small mb-2">
                        <li>Prestatie #@ap.PerformanceId</li>
                        <li>Huidig: @ap.CurrentStart.ToString("HH:mm")–@ap.CurrentEnd.ToString("HH:mm")
                            · Pauze @(ap.CurrentPause is { } cpz ? $"{(int)cpz.TotalMinutes} min" : "—")
                            · ATL @(ap.CurrentAtl?.ToString("0.####") ?? "—")</li>
                        <li>Voorstel: @ap.ProposedStart.ToString("HH:mm")–@ap.ProposedEnd.ToString("HH:mm")
                            · Pauze @(ap.ProposedPause is { } pp ? $"{(int)pp.TotalMinutes} min" : "—")
                            · ATL @(ap.ProposedAtl?.ToString("0.####") ?? "—")</li>
                    </ul>
                    @if (!string.IsNullOrWhiteSpace(ap.PauseExplanationNl) || !string.IsNullOrWhiteSpace(ap.OverlapExplanationNl))
                    {
                        <div class="small border-top pt-2">
                            @if (!string.IsNullOrWhiteSpace(ap.PauseExplanationNl))
                            {
                                <div><strong>Pauzecontrole:</strong> @ap.PauseExplanationNl</div>
                            }
                            @if (!string.IsNullOrWhiteSpace(ap.OverlapExplanationNl))
                            {
                                <div><strong>Overlapcontrole:</strong> @ap.OverlapExplanationNl</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="mb-0 text-muted">Geen uitvoerbaar voorstel.</p>
                }
            </section>
        </div>
    </div>

    @if (canEditCreate && isCreate)
    {
        <details class="mb-4" style="max-width: 40rem;">
            <summary class="small text-muted">Voorstel wijzigen</summary>
            <form method="post"
                  asp-page="/Admin/Payroll/ActionConfirm"
                  asp-page-handler="UpdateCreate"
                  asp-route-ActionId="@Model.ActionId"
                  class="border rounded p-3 mt-2">
                <input type="hidden" asp-for="ActionId" />
                <div class="row g-2 mb-2">
                    <div class="col-4">
                        <label class="form-label" asp-for="EditStart">VAN</label>
                        <input class="form-control" type="time" asp-for="EditStart" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" asp-for="EditEnd">TOT</label>
                        <input class="form-control" type="time" asp-for="EditEnd" />
                    </div>
                    <div class="col-4">
                        <label class="form-label" asp-for="EditMainTaskId">IDHFDTAAK</label>
                        <input class="form-control" type="number" min="1" asp-for="EditMainTaskId" />
                    </div>
                </div>
                <button type="submit" class="btn btn-sm btn-outline-primary">Voorstel opslaan</button>
            </form>
        </details>
    }
    else if (canEditCreate)
    {
        <form method="post"
              asp-page="/Admin/Payroll/ActionConfirm"
              asp-page-handler="UpdateCreate"
              asp-route-ActionId="@Model.ActionId"
              class="border rounded p-3 mb-4"
              style="max-width: 40rem;">
            <input type="hidden" asp-for="ActionId" />
            <h2 class="h6">Voorstel bijwerken</h2>
            <div class="row g-2 mb-2">
                <div class="col-4">
                    <label class="form-label" asp-for="EditStart">VAN</label>
                    <input class="form-control" type="time" asp-for="EditStart" />
                </div>
                <div class="col-4">
                    <label class="form-label" asp-for="EditEnd">TOT</label>
                    <input class="form-control" type="time" asp-for="EditEnd" />
                </div>
                <div class="col-4">
                    <label class="form-label" asp-for="EditMainTaskId">IDHFDTAAK</label>
                    <input class="form-control" type="number" min="1" asp-for="EditMainTaskId" />
                </div>
            </div>
            <button type="submit" class="btn btn-sm btn-outline-primary">Voorstel opslaan</button>
        </form>
    }

    <form method="post"
          asp-page="/Admin/Payroll/ActionConfirm"
          asp-route-ActionId="@Model.ActionId"
          class="vstack gap-3"
          style="max-width: 40rem;">
        <input type="hidden" asp-for="ActionId" />
        <div>
            <label class="form-label" asp-for="Comment">Reden / commentaar</label>
            <textarea class="form-control" asp-for="Comment" rows="3" required></textarea>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (isDelete)
            {
                <button type="submit"
                        asp-page-handler="Execute"
                        asp-route-ActionId="@Model.ActionId"
                        class="btn btn-danger"
                        disabled="@(!view.CanExecute)"
                        data-confirm="Prestatie definitief verwijderen uit Plenion. Doorgaan?">
                    Definitief verwijderen
                </button>
            }
            else if (isCreate)
            {
                <button type="submit"
                        asp-page-handler="Execute"
                        asp-route-ActionId="@Model.ActionId"
                        class="btn btn-primary"
                        disabled="@(!view.CanExecute)"
                        data-confirm="Er wordt een nieuwe urenprestatie in Plenion aangemaakt. Doorgaan?">
                    @(view.Status == PayrollProposedActionStatus.Failed ? "Opnieuw proberen" : "Definitief aanmaken")
                </button>
                <a class="btn btn-outline-secondary"
                   asp-page="./MissingTechnicianWorkbench"
                   asp-route-year="@view.Year"
                   asp-route-month="@view.Month"
                   asp-route-Scope="Open">Terug naar dossier</a>
            }
            else if (isAdjust)
            {
                <button type="submit"
                        asp-page-handler="Execute"
                        asp-route-ActionId="@Model.ActionId"
                        class="btn btn-primary"
                        disabled="@(!view.CanExecute)"
                        data-confirm="De VAN/TOT van deze prestatie wordt in Plenion aangepast. Doorgaan?">
                    Definitief aanpassen
                </button>
            }
            else
            {
                <button type="submit"
                        asp-page-handler="Execute"
                        asp-route-ActionId="@Model.ActionId"
                        class="btn btn-primary"
                        disabled="@(!view.CanExecute)"
                        data-confirm="Deze actie wijzigt Plenion. Doorgaan?">
                    Uitvoeren
                </button>
            }
            <button type="submit"
                    asp-page-handler="Cancel"
                    asp-route-ActionId="@Model.ActionId"
                    class="btn btn-outline-secondary"
                    formnovalidate>
                Annuleren
            </button>
        </div>
        @if (!view.ExecutionEnabled)
        {
            <p class="small text-muted mb-0">Uitvoering staat uit. Je kunt het voorstel wel bekijken.</p>
        }
    </form>
}
