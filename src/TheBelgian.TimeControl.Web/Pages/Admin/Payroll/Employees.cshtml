@page "/Admin/Payroll/Employees"
@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.EmployeesModel
@using TheBelgian.TimeControl.Core.Interfaces
@using TheBelgian.TimeControl.Core.Payroll.Models
@{
    ViewData["Title"] = "Payroll medewerkers";
    var rows = Model.Roster?.Rows ?? [];
}

<div class="cockpit-heading mb-4">
    <div>
        <div class="text-uppercase small text-muted fw-semibold">Payroll shadow</div>
        <h1 class="mb-1">Payroll medewerkers</h1>
        <p class="text-muted mb-0">Wie hoort in onze TimeControl payrollcontrole? Voorstel ≠ bevestigde beslissing.</p>
    </div>
    <div class="cockpit-safety">
        <a asp-page="/Admin/Payroll/Index">Shadow-maanden</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }

<section class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Filter</label>
                <select class="form-select form-select-sm" name="Kind" asp-for="Kind">
                    <option value="@PayrollRosterFilterKind.All">Alles</option>
                    <option value="@PayrollRosterFilterKind.AutoProposed">Auto voorstel</option>
                    <option value="@PayrollRosterFilterKind.Included">Included</option>
                    <option value="@PayrollRosterFilterKind.Excluded">Excluded</option>
                    <option value="@PayrollRosterFilterKind.NeedsDecision">Nog niet bevestigd</option>
                    <option value="@PayrollRosterFilterKind.ManualExtras">Handmatige extras</option>
                    <option value="@PayrollRosterFilterKind.MissingAcerta">Acerta ontbreekt</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Zoek (naam/functie)</label>
                <input class="form-control form-control-sm" name="Search" value="@Model.Search" />
            </div>
            <div class="col-auto">
                <label class="form-label">Peildatum</label>
                <input class="form-control form-control-sm" type="date" name="AsOfDate" value="@((Model.AsOfDate ?? Model.ValidFrom).ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-dark" type="submit">Filter</button>
            </div>
        </form>
        <div class="small text-muted mt-2">
            Auto=@Model.Roster?.AutoSuggestedCount · Included=@Model.Roster?.IncludedCount · Excluded=@Model.Roster?.ExcludedCount · NeedsDecision=@Model.Roster?.NeedsDecisionCount
        </div>
    </div>
</section>

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Selectie bevestigen</h2>
        <p class="small text-muted">Vinkjes zonder expliciete config zijn een <strong>voorstel</strong>. Bevestigen schrijft auditeerbare Included/Excluded beslissingen.</p>
        <form method="post" asp-page-handler="Confirm">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Kind" />
            <input type="hidden" name="Search" value="@Model.Search" />
            <input type="hidden" name="AsOfDate" value="@((Model.AsOfDate ?? Model.ValidFrom).ToString("yyyy-MM-dd"))" />
            <div class="row g-2 align-items-end mb-3">
                <div class="col-auto">
                    <label class="form-label">Geldig vanaf</label>
                    <input class="form-control form-control-sm" type="date" name="ValidFrom" value="@Model.ValidFrom.ToString("yyyy-MM-dd")" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Reason</label>
                    <input class="form-control form-control-sm" name="ReasonCode" value="@Model.ReasonCode" required />
                </div>
                <div class="col-md-4">
                    <label class="form-label">Commentaar</label>
                    <input class="form-control form-control-sm" name="Comment" value="@Model.Comment" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-sm btn-dark" type="submit"
                            onclick="return confirm('Selectie bevestigen voor zichtbare rijen?');">
                        Selectie bevestigen
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>In payrollcontrole</th>
                            <th>Resource</th>
                            <th>Functie</th>
                            <th>Auto voorstel</th>
                            <th>Status</th>
                            <th>Bron</th>
                            <th>Acerta ID</th>
                            <th>Geldig vanaf</th>
                            <th>Geldig tot</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                    @for (var i = 0; i < rows.Count; i++)
                    {
                        var row = rows[i];
                        <tr>
                            <td>
                                <input type="hidden" name="Rows[@i].ResourceId" value="@row.ResourceId" />
                                <input type="hidden" name="Rows[@i].IsOnPayroll" value="false" />
                                <input class="form-check-input" type="checkbox" name="Rows[@i].IsOnPayroll" value="true"
                                       @(row.OnPayrollSuggested ? "checked" : null) />
                            </td>
                            <td>@row.DisplayName <span class="text-muted small">(@row.ResourceId)</span></td>
                            <td>@row.Function</td>
                            <td>@(row.AutoSuggested ? "Ja" : "Nee")</td>
                            <td>
                                @if (!row.HasExplicitConfiguration)
                                {
                                    <span class="badge text-bg-warning">VOORSTEL / NOG NIET BEVESTIGD</span>
                                }
                                else
                                {
                                    @row.EffectiveEligibility
                                }
                            </td>
                            <td>@row.Source</td>
                            <td>@row.AcertaIdentityStatus</td>
                            <td>@(row.ValidFrom?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td>@(row.ValidTo?.ToString("dd/MM/yyyy") ?? "—")</td>
                            <td class="small">@row.ReasonCode</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</section>

<section class="card">
    <div class="card-body">
        <h2 class="h5">Medewerker toevoegen</h2>
        <p class="small text-muted">Zoek een Resource buiten het auto-voorstel (bijv. Designer) en voeg toe als expliciet Included.</p>
        <form method="post" asp-page-handler="SearchManual" class="row g-2 align-items-end mb-3">
            @Html.AntiForgeryToken()
            <input type="hidden" name="Kind" value="@Model.Kind" />
            <input type="hidden" name="AsOfDate" value="@((Model.AsOfDate ?? Model.ValidFrom).ToString("yyyy-MM-dd"))" />
            <div class="col-md-4">
                <label class="form-label">Zoek buiten roster</label>
                <input class="form-control form-control-sm" name="Search" value="@Model.Search" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-outline-secondary" type="submit">Zoeken</button>
            </div>
        </form>

        @if (Model.ManualSearchResults.Count > 0)
        {
            <div class="table-responsive mb-3">
                <table class="table table-sm">
                    <thead><tr><th>Resource</th><th>Functie</th><th></th></tr></thead>
                    <tbody>
                    @foreach (var item in Model.ManualSearchResults)
                    {
                        <tr>
                            <td>@item.DisplayName (@item.ResourceId)</td>
                            <td>@item.Function</td>
                            <td>
                                <form method="post" asp-page-handler="AddManual" class="row g-1 align-items-end">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ManualResourceId" value="@item.ResourceId" />
                                    <div class="col-auto">
                                        <input class="form-control form-control-sm" type="date" name="ManualValidFrom" value="@Model.ManualValidFrom.ToString("yyyy-MM-dd")" required />
                                    </div>
                                    <div class="col-auto">
                                        <input class="form-control form-control-sm" name="ManualReasonCode" value="@Model.ManualReasonCode" />
                                    </div>
                                    <div class="col-auto">
                                        <input class="form-control form-control-sm" name="ManualComment" placeholder="commentaar" />
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-sm btn-dark" type="submit">Toevoegen</button>
                                    </div>
                                </form>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</section>
