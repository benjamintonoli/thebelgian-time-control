@page "/Admin/Payroll/{year:int}/{month:int}/Workbench/Project300"
@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.WorkbenchModel
@using System.Globalization
@using TheBelgian.TimeControl.Core.Payroll.Findings
@using TheBelgian.TimeControl.Core.Payroll.Review
@{
    ViewData["Title"] = $"300 workbench {Model.Month:00}/{Model.Year}";
    var wb = Model.Workbench;
    string ScopeHref(PayrollReviewQueueScope scope) =>
        Url.Page("./Workbench", new
        {
            year = Model.Year,
            month = Model.Month,
            Scope = scope,
            Search = Model.Search,
            Sort = Model.Sort,
            Focus = Model.Focus,
        })!;
    var initialFocus = wb?.SelectedKey ?? Model.Focus;
}

<div class="d-flex justify-content-between align-items-start mb-3 flex-wrap gap-2">
    <div>
        <div class="text-uppercase small text-muted fw-semibold">Payroll · Project 300</div>
        <h1 class="h3 mb-1">Review workbench @Model.Month.ToString("00")/@Model.Year</h1>
        <p class="text-muted mb-0">Queue links · context rechts · GPS async. GPS valideert 300 nooit automatisch.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-sm btn-dark" asp-page="./Workbench" asp-route-year="@Model.Year" asp-route-month="@Model.Month">Werkblad</a>
        <a class="btn btn-sm btn-outline-secondary"
           asp-page="./Queue"
           asp-route-year="@Model.Year"
           asp-route-month="@Model.Month"
           asp-route-Category="Project300"
           asp-route-ListMode="true">Lijst</a>
        <a class="btn btn-sm btn-outline-secondary" asp-page="./Queue" asp-route-year="@Model.Year" asp-route-month="@Model.Month">← Categorieën</a>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }

@if (wb is null)
{
    <div class="alert alert-warning">Shadow-maand niet gevonden.</div>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-2 small">
        <span>Cases <strong>@wb.Cases.Count</strong></span>
        <span class="text-muted">· Open @wb.AdminSummary.UnresolvedAdminByCategory.GetValueOrDefault(PayrollReviewCategory.Project300)</span>
        <span class="text-muted">· Opvolging @wb.AdminSummary.FollowUpAdminByCategory.GetValueOrDefault(PayrollReviewCategory.Project300)</span>
    </div>

    <div class="btn-group btn-group-sm mb-3" role="group">
        <a class="btn @(Model.Scope == PayrollReviewQueueScope.Open ? "btn-dark" : "btn-outline-secondary")" href="@ScopeHref(PayrollReviewQueueScope.Open)">Te beoordelen</a>
        <a class="btn @(Model.Scope == PayrollReviewQueueScope.Closed ? "btn-dark" : "btn-outline-secondary")" href="@ScopeHref(PayrollReviewQueueScope.Closed)">Afgehandeld</a>
        <a class="btn @(Model.Scope == PayrollReviewQueueScope.All ? "btn-dark" : "btn-outline-secondary")" href="@ScopeHref(PayrollReviewQueueScope.All)">Alles</a>
    </div>

    <form method="get" class="cockpit-filters mb-3">
        <input type="hidden" name="year" value="@Model.Year" />
        <input type="hidden" name="month" value="@Model.Month" />
        <input type="hidden" asp-for="Scope" />
        <div>
            <label asp-for="Search">Zoeken</label>
            <input class="form-control form-control-sm" asp-for="Search" placeholder="Medewerker / BON / datum" />
        </div>
        <div>
            <label asp-for="Sort">Sortering</label>
            <select class="form-select form-select-sm" asp-for="Sort">
                <option value="default">Ernst / datum</option>
                <option value="datum">Datum</option>
                <option value="medewerker">Medewerker A-Z</option>
                <option value="duur">Duur</option>
                <option value="status">Status</option>
            </select>
        </div>
        <button class="btn btn-sm btn-dark align-self-end" type="submit">Toepassen</button>
    </form>

    <form id="wb-af" class="d-none">@Html.AntiForgeryToken()</form>

    <div class="timecontrol-cockpit payroll-p300-workbench">
        <aside class="review-queue review-queue-sticky" aria-label="Project 300 queue">
            <div class="queue-title"><strong>300 queue</strong><span>@wb.Cases.Count</span></div>
            <div class="queue-report-form">
                <div class="queue-items" id="p300-queue-items">
                    @foreach (var item in wb.Cases)
                    {
                        var active = string.Equals(wb.SelectedKey, item.AdminCaseKey, StringComparison.Ordinal) ? "active" : null;
                        <article class="queue-case @active" data-admin-case-key="@item.AdminCaseKey" data-resource-id="@item.ResourceId" data-date="@item.Date.ToString("yyyy-MM-dd")">
                            <a class="queue-case-link wb-select-case" href="#" data-admin-case-key="@item.AdminCaseKey" aria-current="@(active is null ? null : "true")">
                                <div class="queue-case-top">
                                    <strong>@(item.DisplayName ?? item.ResourceId)</strong>
                                    <span>@item.Date.ToString("dd/MM")</span>
                                </div>
                                <div class="queue-facts">
                                    <span>@(item.TimeIntervalSummary ?? item.BookedSummary ?? "—")</span>
                                    <span>@PayrollTriageEvidence.FormatHours(item.TotalBookedHours)</span>
                                </div>
                                @{
                                    var techPreview = wb.TechnicianQueuePreviews?.GetValueOrDefault(item.AdminCaseKey)
                                        ?? item.PerformanceDescriptionSummary;
                                }
                                @if (!string.IsNullOrWhiteSpace(techPreview))
                                {
                                    <div class="queue-customer text-truncate" title="@techPreview">“@techPreview”</div>
                                }
                                <div class="queue-case-bottom">
                                    @{
                                        var openish = PayrollReviewCategories.IsUnresolved(item.WorkflowStatus);
                                        var hint = Model.GpsHints.GetValueOrDefault(item.AdminCaseKey);
                                        var hintText = hint switch
                                        {
                                            PayrollProject300GpsCacheHint.Available => "GPS✓",
                                            PayrollProject300GpsCacheHint.Unavailable => "GPS–",
                                            PayrollProject300GpsCacheHint.Cached => "GPS✓",
                                            _ => "",
                                        };
                                    }
                                    <span class="queue-status-dot @(openish ? "text-warning" : "text-success")" title="@PayrollGuidedDecisions.AdminStatusLabel(item.WorkflowStatus)">●</span>
                                    @if (!string.IsNullOrEmpty(hintText))
                                    {
                                        <span class="queue-gps-hint text-muted">@hintText</span>
                                    }
                                </div>
                            </a>
                        </article>
                    }
                    @if (wb.Cases.Count == 0)
                    {
                        <div class="p-3 small text-muted">Geen cases voor deze filters.</div>
                    }
                </div>
            </div>
        </aside>

        <main class="case-detail position-relative" id="p300-case-detail">
            <div class="empty-detail p-4" id="p300-detail-placeholder">
                <h2 class="h5">Context laden…</h2>
                <p class="text-muted mb-0">Maandcontext en geselecteerde case worden geladen.</p>
            </div>
        </main>
    </div>
}

@section Scripts {
<style>
.payroll-p300-workbench { min-height: 720px; }
.payroll-p300-workbench .review-queue { width: auto; }
.p300-sticky-decisions {
  position: sticky;
  bottom: 0;
  z-index: 5;
  box-shadow: 0 -6px 16px rgba(0,0,0,.04);
}
.p300-day-timeline .p300-tl-time,
.p300-day-timeline .p300-tl-title,
.p300-day-timeline .p300-tl-sub {
  color: #1a1d21;
}
.p300-day-timeline .p300-tl-secondary {
  color: #495057;
}
.p300-context-summary {
  background: #f8f9fa;
  border-left: 4px solid #1a1d21;
  padding: .75rem 1rem;
}
.p300-full-day > summary {
  cursor: pointer;
  color: #1a1d21;
}
.p300-badge {
  font-size: .7rem;
  font-weight: 600;
  letter-spacing: .02em;
  border: 1px solid transparent;
}
.p300-badge-gps {
  background: #0b3d5c;
  color: #fff;
}
.p300-badge-300 {
  background: #7a1f1f;
  color: #fff;
}
.p300-badge-planning {
  background: #1b4332;
  color: #fff;
}
.p300-badge-prestatie {
  background: #343a40;
  color: #fff;
}
@@media (min-width: 992px) {
  .payroll-p300-workbench { grid-template-columns: minmax(260px, 32%) minmax(0, 68%); }
}
</style>
<script>
(function () {
  const token = document.querySelector('#wb-af input[name="__RequestVerificationToken"]')?.value;
  const decideUrl = '@Url.Page("./Workbench", new { year = Model.Year, month = Model.Month, handler = "Decide" })';
  const corrUrl = '@Url.Page("./Workbench", new { year = Model.Year, month = Model.Month, handler = "ProposeCorrection" })';
  const detailUrl = '@Url.Page("./Workbench", new { year = Model.Year, month = Model.Month, handler = "Detail", Scope = Model.Scope, Search = Model.Search, Sort = Model.Sort })';
  const gpsBase = '@Url.Page("./Workbench", new { year = Model.Year, month = Model.Month, handler = "Gps" })';
  const detailHost = document.getElementById('p300-case-detail');
  let currentKey = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(initialFocus));
  let loadSeq = 0;

  async function loadDetail(key) {
    if (!detailHost || !key) return;
    const seq = ++loadSeq;
    currentKey = key;
    document.querySelectorAll('.queue-case').forEach(el => {
      el.classList.toggle('active', el.dataset.adminCaseKey === key);
    });
    detailHost.innerHTML = '<div class="empty-detail p-4"><h2 class="h5">Context laden…</h2><p class="text-muted mb-0">Even geduld.</p></div>';
    const url = detailUrl + (detailUrl.includes('?') ? '&' : '?') + 'adminCaseKey=' + encodeURIComponent(key);
    const response = await fetch(url, { headers: { 'Accept': 'text/html' } });
    if (!response.ok) {
      detailHost.innerHTML = '<div class="alert alert-danger m-3">Detail laden mislukt.</div>';
      return;
    }
    const html = await response.text();
    if (seq !== loadSeq) return;
    detailHost.innerHTML = html;
    wireDetail();
    const urlObj = new URL(window.location.href);
    urlObj.searchParams.set('Focus', key);
    history.replaceState(null, '', urlObj.pathname + urlObj.search);
  }

  function wireDetail() {
    document.querySelectorAll('.wb-decide').forEach(btn => {
      btn.addEventListener('click', async () => {
        const wrap = document.getElementById('wb-decisions');
        const err = document.getElementById('wb-decide-error');
        err?.classList.add('d-none');
        const adminCaseKey = wrap?.dataset.adminCaseKey;
        const decisionCode = btn.dataset.decision;
        const requiresComment = btn.dataset.requiresComment === 'true';
        let comment = document.getElementById('wb-comment')?.value?.trim() || '';
        if (requiresComment && !comment) {
          comment = window.prompt(btn.dataset.label + ' — toelichting:') || '';
          const input = document.getElementById('wb-comment');
          if (input) input.value = comment;
        }
        if (requiresComment && !comment.trim()) {
          if (err) { err.textContent = 'Toelichting is verplicht.'; err.classList.remove('d-none'); }
          return;
        }
        if (decisionCode === '@PayrollGuidedDecisionCodes.P300HoursWrong') {
          document.getElementById('correction-panel')?.classList.remove('d-none');
        }
        btn.disabled = true;
        try {
          const body = new URLSearchParams();
          body.set('AdminCaseKey', adminCaseKey);
          body.set('DecisionCode', decisionCode);
          body.set('Comment', comment);
          if (token) body.set('__RequestVerificationToken', token);
          const response = await fetch(decideUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'RequestVerificationToken': token || '' },
            body
          });
          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Mislukt');
          if (payload.openCorrection) {
            document.getElementById('correction-panel')?.classList.remove('d-none');
            btn.disabled = false;
            return;
          }
          const article = document.querySelector('.queue-case[data-admin-case-key="' + CSS.escape(adminCaseKey) + '"]');
          if (article && payload.hideRow) article.classList.add('d-none');
          if (payload.nextKey) await loadDetail(payload.nextKey);
          else location.reload();
        } catch (e) {
          if (err) { err.textContent = e.message || 'Fout'; err.classList.remove('d-none'); }
          btn.disabled = false;
        }
      });
    });

    document.querySelectorAll('.wb-propose-corr').forEach(btn => {
      btn.addEventListener('click', async () => {
        const box = btn.closest('.correction-target');
        const err = document.getElementById('wb-corr-error');
        const ok = document.getElementById('wb-corr-ok');
        err?.classList.add('d-none');
        ok?.classList.add('d-none');
        try {
          const body = new URLSearchParams();
          body.set('AdminCaseKey', document.getElementById('wb-decisions')?.dataset.adminCaseKey);
          body.set('PerformanceId', box?.dataset.performanceId);
          body.set('NewStart', box?.querySelector('.corr-start')?.value);
          body.set('NewEnd', box?.querySelector('.corr-end')?.value);
          body.set('CorrectionReason', box?.querySelector('.corr-reason')?.value || '');
          if (token) body.set('__RequestVerificationToken', token);
          const response = await fetch(corrUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8', 'RequestVerificationToken': token || '' },
            body
          });
          const payload = await response.json();
          if (!response.ok || !payload.ok) throw new Error(payload.error || 'Mislukt');
          if (ok) { ok.textContent = payload.message || 'Opgeslagen'; ok.classList.remove('d-none'); }
        } catch (e) {
          if (err) { err.textContent = e.message || 'Fout'; err.classList.remove('d-none'); }
        }
      });
    });

    const gpsPanel = document.getElementById('gps-panel');
    if (gpsPanel && gpsPanel.dataset.loading === 'true') {
      const key = gpsPanel.dataset.adminCaseKey;
      fetch(gpsBase + (gpsBase.includes('?') ? '&' : '?') + 'adminCaseKey=' + encodeURIComponent(key), { headers: { 'Accept': 'application/json' } })
        .then(r => r.json())
        .then(payload => {
          const status = document.getElementById('gps-inline-status');
          if (status) status.textContent = payload.available ? (payload.summary || 'GPS beschikbaar') : (payload.summary || 'Geen betrouwbare GPS-context beschikbaar.');
          const article = document.querySelector('.queue-case[data-admin-case-key="' + CSS.escape(key) + '"] .queue-gps-hint');
          if (article) article.textContent = payload.available ? 'GPS✓' : 'GPS–';
          // Refresh detail once so unified timeline includes GPS (cached).
          if (payload.cacheHit || payload.available || payload.ok) {
            loadDetail(key);
          }
        })
        .catch(() => {
          const status = document.getElementById('gps-inline-status');
          if (status) status.textContent = 'Geen betrouwbare GPS-context beschikbaar.';
        });
    }
  }

  document.querySelectorAll('.wb-select-case').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const key = link.dataset.adminCaseKey;
      if (key) loadDetail(key);
    });
  });

  if (currentKey) loadDetail(currentKey);
  else {
    const first = document.querySelector('.queue-case:not(.d-none)');
    if (first?.dataset.adminCaseKey) loadDetail(first.dataset.adminCaseKey);
  }
})();
</script>
}
