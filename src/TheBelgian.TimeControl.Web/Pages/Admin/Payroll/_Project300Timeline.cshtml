@model IEnumerable<TheBelgian.TimeControl.Core.Payroll.Review.PayrollProject300DayTimelineEntry>
@using TheBelgian.TimeControl.Core.Payroll.Review
@{
    string FmtTime(DateTimeOffset? value) => value?.ToString("HH:mm") ?? "—";
    var listId = ViewData["ListId"] as string ?? "p300-timeline";
}
<ul class="list-unstyled p300-day-timeline mb-0" id="@listId">
@foreach (var entry in Model)
{
    <li class="d-flex gap-2 py-2 border-bottom p300-tl-row @(entry.IsSelected300 ? "p300-tl-selected" : "")">
        <div class="text-nowrap small fw-semibold p300-tl-time" style="min-width: 5.5rem;">
            @FmtTime(entry.Start)@if (entry.End is { } e) { <span>–@e.ToString("HH:mm")</span> }
        </div>
        <div class="p300-tl-body">
            <span class="badge p300-badge p300-badge-@entry.Badge.ToLowerInvariant()">@entry.Badge</span>
            <span class="p300-tl-title @(entry.IsSelected300 ? "fw-semibold" : "")">@entry.Title</span>
            @if (!string.IsNullOrWhiteSpace(entry.Subtitle))
            {
                <div class="small p300-tl-sub">@entry.Subtitle</div>
            }
            @if (!string.IsNullOrWhiteSpace(entry.SecondaryDetail) && entry.Kind == PayrollProject300DayTimelineKind.Gps)
            {
                <div class="small p300-tl-secondary">@entry.SecondaryDetail</div>
            }
        </div>
    </li>
}
</ul>
