@page "/Admin/Payroll/{year:int}/{month:int}/{resourceId}"
@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.EmployeeModel
@using TheBelgian.TimeControl.Core.Payroll.Models
@{
    ViewData["Title"] = $"Payroll shadow {Model.ResourceId}";
    var detail = Model.Detail;
    var employee = detail?.Employee;
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1>@(employee?.DisplayNameSnapshot ?? Model.ResourceId)</h1>
        <p class="text-muted mb-0">@Model.Month.ToString("00")/@Model.Year · Resource @Model.ResourceId</p>
    </div>
    <a class="btn btn-sm btn-outline-secondary" asp-page="./Month" asp-route-year="@Model.Year" asp-route-month="@Model.Month">← Maand</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }

@if (employee is null)
{
    <div class="alert alert-warning">Medewerker niet gevonden.</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h2 class="h6">Payrollresultaat</h2>
            <dl class="row mb-0">
                <dt class="col-5">Theoretische uren</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.LegacyTheoreticalHours)</dd>
                <dt class="col-5">Berekende uren</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.LegacyActualOrdinaryHours)</dd>
                <dt class="col-5">Verschil</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.LegacyDifferenceHours)</dd>
                <dt class="col-5">Wachtdienst 200%</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.StandbyRoundedHours)</dd>
                <dt class="col-5">Stadsritten</dt><dd class="col-7">@(employee.CityTripUnits?.ToString() ?? "—") / @PayrollDisplayFormatting.Euro(employee.CityAllowanceAmount)</dd>
                <dt class="col-5">KM-vergoeding</dt><dd class="col-7">@PayrollDisplayFormatting.Euro(employee.KmAmount)</dd>
                <dt class="col-5">Looncode 414</dt><dd class="col-7">@PayrollDisplayFormatting.Euro(employee.Code414Amount)</dd>
            </dl>
            <details class="mt-3">
                <summary class="small text-muted">Berekeningsdetails</summary>
                <dl class="row small mb-0 mt-2">
                    <dt class="col-5">Wachtdienst exact</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.StandbyExactHours)</dd>
                    <dt class="col-5">KM</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.EligibleKm)</dd>
                    <dt class="col-5">Extra75 legacy</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.Extra75LegacyValue)</dd>
                    <dt class="col-5">KM-tarief</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.KmRate)</dd>
                    <dt class="col-5">Overuren 150% / 200%</dt><dd class="col-7">@PayrollDisplayFormatting.Hours(employee.Code135At150Units) / @PayrollDisplayFormatting.Hours(employee.Code135At200Units)</dd>
                </dl>
            </details>
        </div></div></div>
        <div class="col-md-6"><div class="card h-100"><div class="card-body">
            <h2 class="h6">Eligibility &amp; review</h2>
            <p><strong>Effectief:</strong> @PayrollReviewLabels.Eligibility(employee.EligibilityStatus) @(employee.EligibilityReason is not null ? $"({employee.EligibilityReason})" : "")</p>
            <p class="small text-muted"><strong>Suggestie:</strong> @(employee.SuggestedEligibility is null ? "—" : PayrollReviewLabels.Eligibility(employee.SuggestedEligibility.Value)) · @(employee.SuggestedReason ?? "—")</p>
            <p><strong>Review:</strong> @PayrollReviewLabels.ReviewStatus(employee.ReviewStatus)</p>
            <p><strong>Acerta ID:</strong> @employee.AcertaIdentityStatus</p>
        </div></div></div>
    </div>

    @if (detail!.Month.Status != PayrollShadowMonthStatus.Finalized)
    {
        <div class="row g-3 mb-4">
            <div class="col-md-6"><div class="card"><div class="card-body">
                <h2 class="h6">Reviewbeslissing</h2>
                <form method="post" class="row g-2">
                    <input type="hidden" asp-for="Year" /><input type="hidden" asp-for="Month" /><input type="hidden" asp-for="ResourceId" />
                    <div class="col-12"><label class="form-label">Commentaar (optioneel)</label><input class="form-control form-control-sm" asp-for="ReviewComment" /></div>
                    <div class="col-12 d-flex flex-wrap gap-2">
                        <button class="btn btn-success" type="submit" asp-page-handler="Accept">Goedkeuren</button>
                        <button class="btn btn-outline-success" type="submit" asp-page-handler="AcceptAndNext">Goedkeuren &amp; volgende</button>
                        <button class="btn btn-warning" type="submit" asp-page-handler="NeedsFollowUp">Opvolging nodig</button>
                        <button class="btn btn-sm btn-outline-secondary" type="submit" asp-page-handler="ResetReview">Reset Pending</button>
                    </div>
                </form>
            </div></div></div>
            <div class="col-md-6"><div class="card"><div class="card-body">
                <h2 class="h6">Eligibility-actie</h2>
                <form method="post" class="row g-2">
                    <input type="hidden" asp-for="Year" /><input type="hidden" asp-for="Month" /><input type="hidden" asp-for="ResourceId" />
                    <div class="col-6"><label class="form-label">ValidFrom</label><input class="form-control form-control-sm" type="date" asp-for="ValidFrom" /></div>
                    <div class="col-6"><label class="form-label">ValidTo</label><input class="form-control form-control-sm" type="date" asp-for="ValidTo" /></div>
                    <div class="col-12"><label class="form-label">Reason</label><input class="form-control form-control-sm" asp-for="ReasonCode" required /></div>
                    <div class="col-12"><label class="form-label">Comment</label><input class="form-control form-control-sm" asp-for="Comment" /></div>
                    <div class="col-12 d-flex gap-2">
                        <button class="btn btn-sm btn-success" type="submit" asp-page-handler="Include">Include</button>
                        <button class="btn btn-sm btn-warning" type="submit" asp-page-handler="Exclude">Exclude</button>
                        <button class="btn btn-sm btn-outline-secondary" type="submit" asp-page-handler="ResetEligibility">Reset NeedsDecision</button>
                    </div>
                </form>
            </div></div></div>
        </div>
    }

    <section class="card mb-3"><div class="card-body">
        <h2 class="h6">Bevindingen</h2>
        @if (detail.Findings.Count == 0)
        {
            <p class="mb-0 text-muted">Geen bevindingen voor deze medewerker.</p>
        }
        else
        {
            <div class="vstack gap-3">
            @foreach (var finding in detail.Findings)
            {
                <div class="border rounded p-2">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-1">
                        <span class="badge @PayrollReviewLabels.SeverityBadgeClass(finding.Severity)">@PayrollReviewLabels.FindingSeverity(finding.Severity)</span>
                        <strong>@finding.Title</strong>
                        <span class="text-muted small">@finding.Date.ToString("dd/MM/yyyy")</span>
                        <span class="text-muted small">@PayrollReviewLabels.FindingType(finding.FindingType)</span>
                    </div>
                    <p class="mb-1">@finding.Description</p>
                    @if (finding.PlannedHours is not null || finding.BookedHours is not null || finding.SuggestedPayableHours is not null)
                    {
                        <p class="mb-1 small">
                            Geboekt: @PayrollDisplayFormatting.Hours(finding.BookedHours)
                            @if (finding.PlannedHours is not null)
                            {
                                <text>· Gepland/GPS: @PayrollDisplayFormatting.Hours(finding.PlannedHours)</text>
                            }
                            @if (finding.OverlapHours is not null)
                            {
                                <text>· Overlap: @PayrollDisplayFormatting.Hours(finding.OverlapHours)</text>
                            }
                            @if (finding.SuggestedPayableHours is not null)
                            {
                                <text>· Voorstel uren: @PayrollDisplayFormatting.Hours(finding.SuggestedPayableHours)</text>
                            }
                            @if (finding.SuggestedOvertimeAdjustmentHours is not null)
                            {
                                <text>· Voorstel overuren: @PayrollDisplayFormatting.Hours(finding.SuggestedOvertimeAdjustmentHours)</text>
                            }
                        </p>
                    }
                    @if (finding.SuggestedPayableStart is not null || finding.SuggestedPayableEnd is not null || finding.SuggestedProjectId is not null)
                    {
                        <p class="mb-1 small">
                            @if (finding.SuggestedPayableStart is not null || finding.SuggestedPayableEnd is not null)
                            {
                                <text>Voorstel interval: @(finding.SuggestedPayableStart?.ToString("HH:mm") ?? "—")–@(finding.SuggestedPayableEnd?.ToString("HH:mm") ?? "—")</text>
                            }
                            @if (finding.SuggestedProjectId is not null)
                            {
                                <text> · Voorstel dossier: @finding.SuggestedProjectId@(string.IsNullOrWhiteSpace(finding.SuggestedBonNr) ? "" : $" / BON {finding.SuggestedBonNr}")</text>
                            }
                        </p>
                    }
                    @if (!string.IsNullOrWhiteSpace(finding.GpsClassification))
                    {
                        <p class="mb-1 small text-muted">GPS-classificatie: @finding.GpsClassification</p>
                    }
                    <p class="mb-1 small"><em>@finding.SuggestedAction</em></p>
                    <details>
                        <summary class="small text-muted">Technische evidence</summary>
                        <pre class="small mb-0 mt-1">@finding.Evidence</pre>
                        <div class="small text-muted">Key=@finding.FindingKey · Status=@finding.Status · Ids=@finding.RelatedPerformanceIdsJson</div>
                    </details>
                </div>
            }
            </div>
        }
    </div></section>

    <section class="card mb-3"><div class="card-body">
        <h2 class="h6">Eligibility-configuratie (effectief gedateerd)</h2>
        <ul class="small mb-0">
        @foreach (var config in detail.EligibilityConfigurations)
        {
            <li>@config.ValidFrom.ToString("dd/MM/yyyy") – @(config.ValidTo?.ToString("dd/MM/yyyy") ?? "∞"): @PayrollReviewLabels.Eligibility(config.EligibilityStatus) — @config.ReasonCode (@config.DecisionSource)</li>
        }
        </ul>
    </div></section>

    <section class="card"><div class="card-body">
        <h2 class="h6">Audit</h2>
        <ul class="small mb-0">
        @foreach (var audit in detail.AuditTrail)
        {
            <li>@audit.TimestampUtc.ToLocalTime(): @audit.Action by @audit.Actor @(audit.ReasonCode is not null ? $"({audit.ReasonCode})" : "")</li>
        }
        </ul>
    </div></section>
}
