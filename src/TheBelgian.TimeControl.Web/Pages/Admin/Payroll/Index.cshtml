@page "/Admin/Payroll"
@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.IndexModel
@using TheBelgian.TimeControl.Core.Payroll.Models
@{
    ViewData["Title"] = "Looncontrole";
}

<div class="cockpit-heading mb-4">
    <div>
        <div class="text-uppercase small text-muted fw-semibold">Looncontrole</div>
        <h1 class="mb-1">Looncontrole-maanden</h1>
        <p class="text-muted mb-0">Controle van geregistreerde uren op basis van Plenion, planning en Track &amp; Trace.</p>
    </div>
    <div class="cockpit-safety">
        <a asp-page="./Employees">Medewerkers</a>
        · Suggesties ≠ beslissing · Geen automatische Plenion-writes
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Message)) { <div class="alert alert-success">@Model.Message</div> }
@if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="alert alert-danger">@Model.Error</div> }

@if (Model.CanonicalMonth is { } canonical)
{
    <div class="alert alert-light border mb-4">
        <div class="fw-semibold mb-1">Actieve / relevante periode</div>
        <div class="mb-2">
            <a asp-page="./Month" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">
                @canonical.Month.ToString("00")/@canonical.Year
            </a>
            · @PayrollReviewLabels.MonthStatus(canonical.Status)
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-sm btn-primary" asp-page="./Control" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Control Center</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="./Month" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Medewerkers</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="./Queue" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Queue / review</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="./Workbench" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Project 300 workbench</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="./Project200Workbench" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Project 200 workbench</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="./Project100Workbench" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Project 100 / opleiding</a>
            <a class="btn btn-sm btn-outline-primary" asp-page="./StandbyWorkbench" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Wachtdienst workbench</a>
            <a class="btn btn-sm btn-outline-secondary" asp-page="./Finalize" asp-route-year="@canonical.Year" asp-route-month="@canonical.Month">Afronden / status</a>
        </div>
    </div>
}

<section class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Nieuwe shadow-maand</h2>
        <form method="post" asp-page-handler="Create" class="row g-2 align-items-end">
            <div class="col-auto">
                <label class="form-label">Jaar</label>
                <input class="form-control form-control-sm" type="number" name="Year" value="@(Model.Year ?? DateTime.Today.Year)" min="2000" max="2100" />
            </div>
            <div class="col-auto">
                <label class="form-label">Maand</label>
                <input class="form-control form-control-sm" type="number" name="Month" value="@(Model.Month ?? DateTime.Today.Month)" min="1" max="12" />
            </div>
            <div class="col-auto">
                <label class="form-label">Evaluatiedatum</label>
                <input class="form-control form-control-sm" type="date" name="EvaluationDate" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-dark" type="submit">Snapshot aanmaken</button>
            </div>
        </form>
    </div>
</section>

<section class="card">
    <div class="card-body table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th>Maand</th>
                    <th>Status</th>
                    <th>Aangemaakt</th>
                    <th>Evaluatie</th>
                    <th>Versie</th>
                    <th>Kandidaten</th>
                    <th>Incl.</th>
                    <th>Uitgesl.</th>
                    <th>Beslissing</th>
                    <th>Review</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model.Months)
            {
                <tr>
                    <td><a asp-page="./Month" asp-route-year="@item.Year" asp-route-month="@item.Month">@item.Month.ToString("00")/@item.Year</a></td>
                    <td>@PayrollReviewLabels.MonthStatus(item.Status)</td>
                    <td>@item.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.EvaluationDate.ToString("dd/MM/yyyy")</td>
                    <td class="small font-monospace">@item.CalculationVersion</td>
                    <td>@item.TotalCandidates</td>
                    <td>@item.Included</td>
                    <td>@item.Excluded</td>
                    <td>@item.NeedsDecision</td>
                    <td>@item.PendingReview / @item.NeedsFollowUp / @item.Accepted</td>
                    <td class="text-nowrap">
                        <a class="small" asp-page="./Control" asp-route-year="@item.Year" asp-route-month="@item.Month">Control</a>
                        ·
                        <a class="small" asp-page="./Queue" asp-route-year="@item.Year" asp-route-month="@item.Month">Queue</a>
                        ·
                        <a class="small" asp-page="./Workbench" asp-route-year="@item.Year" asp-route-month="@item.Month">300</a>
                        <a class="small" asp-page="./Project200Workbench" asp-route-year="@item.Year" asp-route-month="@item.Month">200</a>
                        <a class="small" asp-page="./Project100Workbench" asp-route-year="@item.Year" asp-route-month="@item.Month">100</a>
                    </td>
                </tr>
            }
            @if (Model.Months.Count == 0)
            {
                <tr>
                    <td colspan="11" class="text-muted">Nog geen shadow-maanden. Maak hierboven een snapshot aan.</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
