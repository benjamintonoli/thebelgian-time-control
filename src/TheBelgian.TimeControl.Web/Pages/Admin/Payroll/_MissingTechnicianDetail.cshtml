@model TheBelgian.TimeControl.Web.Pages.Admin.Payroll.MissingTechnicianWorkbenchModel
@using System.Globalization
@using TheBelgian.TimeControl.Core.Payroll.Findings
@using TheBelgian.TimeControl.Core.Payroll.Review
@{
    var nl = CultureInfo.GetCultureInfo("nl-BE");
    var wb = Model.Workbench;
    var selected = wb?.Detail?.AdminCase;
    var detail = wb?.Detail;
    var missing = detail?.Missing;
    var expl = missing?.Explanation
        ?? (missing is null
            ? null
            : MissingTechnicianAdminExplainability.Build(
                missing.FindingEvidence,
                missing.PeerResourceId,
                missing.PeerDisplayName,
                missing.PeerStart,
                missing.PeerEnd,
                missing.ProposalStart,
                missing.ProposalEnd,
                missing.ProposalHours,
                missing.SuggestedProjectId,
                missing.SuggestedBonNr,
                missing.SuggestedMainTaskId,
                missing.TravelMode,
                missing.CanProposeCreate));
    string FmtTime(TimeOnly? value) => value?.ToString("HH:mm") ?? "—";
    string FmtHours(decimal? hours) => hours is null ? "—" : hours.Value.ToString("0.##", nl) + " u";
    var taskLabel = missing?.SuggestedMainTaskId is int taskId && taskId > 0
        ? $"{taskId} — Werkuren Onderhoudstechnicus"
        : (expl?.ProposalTaskLabel ?? "—");
}

@if (detail is null || selected is null || missing is null || expl is null)
{
    <div class="empty-detail p-4">
        <h2 class="h5">Geen ontbrekende-prestatie detail</h2>
        <p class="text-muted mb-0">Selecteer een case in de queue.</p>
    </div>
}
else
{
    <div class="missing-detail-body tc-mt-detail tc-mt-v4" data-admin-case-key="@selected.AdminCaseKey">
        <header class="mb-3">
            <div class="text-uppercase small text-muted fw-semibold">Ontbrekende prestatie</div>
            <h2 class="h4 mb-1">@(selected.DisplayName ?? selected.ResourceId)</h2>
            <div class="text-muted">@PayrollDisplayFormatting.DateWithWeekday(selected.Date)</div>
            <div class="fw-semibold mt-2">@(expl.CustomerSiteLabel ?? "—")</div>
            <div class="small text-muted">
                Project @(missing.SuggestedProjectId ?? "—")
                @if (!string.IsNullOrWhiteSpace(missing.SuggestedBonNr))
                {
                    <span>· BON @missing.SuggestedBonNr</span>
                }
            </div>
            <div class="mt-2">
                <span class="badge text-bg-light text-dark border">@PayrollGuidedDecisions.AdminStatusLabel(selected.WorkflowStatus)</span>
            </div>
        </header>

        <section class="border rounded p-3 mb-3 tc-mt-recommend">
            <div class="text-uppercase small text-muted fw-semibold mb-2">Voorgestelde prestatie</div>
            <div class="fs-3 fw-semibold">@(expl.ProposalInterval ?? $"{FmtTime(missing.ProposalStart)}–{FmtTime(missing.ProposalEnd)}")</div>
            <div class="fs-5 mb-2">@FmtHours(missing.ProposalHours)</div>
            <div class="small fw-semibold text-primary">TIJD OP BASIS VAN · @(expl.TimingSourcePrimary?.ToUpperInvariant() ?? "EIGEN TRACK & TRACE")</div>
            @if (!string.IsNullOrWhiteSpace(expl.TimingSourceSupporting))
            {
                <div class="small text-muted">Ondersteund door: @expl.TimingSourceSupporting</div>
            }
            <div class="row g-2 small mt-2">
                <div class="col-md-6">Planning: @(expl.PlanningInterval ?? "—")</div>
                <div class="col-md-6">
                    Collega op dezelfde job:
                    @(expl.PeerDisplayName ?? "—")
                    @(string.IsNullOrWhiteSpace(expl.PeerInterval) ? "" : " · " + expl.PeerInterval)
                </div>
            </div>
        </section>

        <section class="mb-3">
            <div class="text-uppercase small text-muted fw-semibold mb-2">Waarom dit voorstel?</div>
            <ul class="mb-2">
                @foreach (var bullet in expl.WhyBullets.Take(4))
                {
                    <li>@bullet</li>
                }
            </ul>
            @if (!string.IsNullOrWhiteSpace(expl.AllocationReviewNl))
            {
                <div class="small text-warning-emphasis">⚠ @expl.AllocationReviewNl</div>
            }
        </section>

        <section class="border rounded p-3 mb-3">
            <div class="text-uppercase small text-muted fw-semibold mb-2">Collega op dezelfde job</div>
            <div class="fw-semibold">@(expl.PeerDisplayName ?? "—")</div>
            <div>@(expl.PeerInterval ?? "—")</div>
            <div class="small text-muted mt-1">
                Zelfde Project @(missing.SuggestedProjectId ?? "—")
                @if (!string.IsNullOrWhiteSpace(missing.SuggestedBonNr))
                {
                    <span>· Zelfde BON @missing.SuggestedBonNr</span>
                }
            </div>
            <div class="small text-muted">Reiswijze: @PayrollReviewLabels.MissingTechnicianTravelMode(missing.TravelMode)</div>
        </section>

        @if (expl.TimelineLines.Count > 0)
        {
            <section class="mb-3">
                <div class="text-uppercase small text-muted fw-semibold mb-2">Track &amp; Trace</div>
                <ul class="list-unstyled small mb-2 tc-mt-timeline-compact">
                    @foreach (var line in expl.TimelineLines.Take(5))
                    {
                        <li>@line</li>
                    }
                </ul>
                <details>
                    <summary class="small text-muted">Meer tijdlijninformatie</summary>
                    <ul class="list-unstyled small mb-0 mt-2">
                        @foreach (var line in expl.TimelineLines.Skip(5))
                        {
                            <li>@line</li>
                        }
                    </ul>
                    <div class="small text-muted mt-2">@expl.WorkContinuityNl</div>
                </details>
            </section>
        }

        @if (!string.IsNullOrWhiteSpace(expl.ExistingOtherBookingNl))
        {
            <section class="border rounded p-2 mb-3 small bg-light">
                <div class="text-uppercase text-muted fw-semibold mb-1">Andere boeking dezelfde dag</div>
                <div>@expl.ExistingOtherBookingNl</div>
                <div class="text-muted">Geen materiële overlap met dit voorstel.</div>
            </section>
        }

        <details class="mb-4">
            <summary class="small text-muted">Technische details</summary>
            <div class="border rounded p-3 mt-2 small">
                <div>EvidenceClass: @missing.EvidenceClass</div>
                <div>TravelMode: @missing.TravelMode</div>
                <div>ProposalSource: @missing.ProposalSource</div>
                <div class="mt-2 text-muted">@missing.FindingEvidence</div>
                <div class="mt-2" id="gps-inline-status">@(detail.GpsContext.IsLoading ? "GPS-context laden…" : detail.GpsContext.Summary)</div>
                <div id="gps-panel"
                     data-admin-case-key="@selected.AdminCaseKey"
                     data-loading="@(detail.GpsContext.IsLoading ? "true" : "false")">
                    <ul class="list-unstyled mb-0" id="gps-events">
                        @foreach (var ev in detail.GpsContext.Events)
                        {
                            <li>
                                <strong>@ev.At.ToString("HH:mm")@(ev.End is null ? "" : "–" + ev.End.Value.ToString("HH:mm"))</strong>
                                @ev.Label
                            </li>
                        }
                    </ul>
                </div>
                <div id="travel-mode-label" class="d-none">@PayrollReviewLabels.MissingTechnicianTravelMode(missing.TravelMode)</div>
                <div id="gps-site-summary" class="d-none">
                    @if (missing.GpsSiteStart is not null)
                    {
                        <span>@FmtTime(missing.GpsSiteStart)|@(missing.GpsSiteEnd is null ? "" : FmtTime(missing.GpsSiteEnd))</span>
                    }
                </div>
            </div>
        </details>

        @if (missing.CanProposeCreate)
        {
            <section class="border rounded p-3 mb-3" id="create-panel"
                     data-peer-start="@(missing.PeerStart?.ToString("HH:mm"))"
                     data-peer-end="@(missing.PeerEnd?.ToString("HH:mm"))"
                     data-gps-start="@(missing.GpsSiteStart?.ToString("HH:mm"))"
                     data-gps-end="@(missing.GpsSiteEnd?.ToString("HH:mm"))">
                <div class="text-uppercase small text-muted fw-semibold mb-2">Prestatie aanmaken</div>
                <div class="row g-2 align-items-end">
                    <div class="col-auto">
                        <label class="form-label small mb-0">VAN</label>
                        <input class="form-control form-control-sm create-start" type="time" value="@FmtTime(missing.ProposalStart)" />
                    </div>
                    <div class="col-auto">
                        <label class="form-label small mb-0">TOT</label>
                        <input class="form-control form-control-sm create-end" type="time" value="@FmtTime(missing.ProposalEnd)" />
                    </div>
                    <div class="col-md-5">
                        <label class="form-label small mb-0">Taak</label>
                        <input class="form-control form-control-sm" value="@taskLabel" readonly />
                    </div>
                    <div class="col-12">
                        <label class="form-label small mb-0">Reden</label>
                        <input class="form-control form-control-sm create-reason" placeholder="Korte reden (verplicht bij definitief aanmaken)" value="@(selected.ReviewComment ?? "")" />
                    </div>
                    <div class="col-12">
                        <button type="button" class="btn btn-primary wb-propose-create">Prestatie aanmaken</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary ms-1" id="wb-use-gps"
                                @(missing.GpsSiteStart is null || missing.GpsSiteEnd is null ? "disabled" : null)>
                            GPS-uren
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="wb-use-peer"
                                @(missing.PeerStart is null || missing.PeerEnd is null ? "disabled" : null)>
                            Uren collega
                        </button>
                    </div>
                </div>
                <div class="alert alert-danger small d-none mt-2 mb-0" id="wb-create-error"></div>
            </section>
        }
        else
        {
            <div class="alert alert-secondary small">@(missing.CreateBlockReason ?? "Create niet beschikbaar voor deze case.")</div>
            <div id="create-panel" class="d-none"
                 data-peer-start="@(missing.PeerStart?.ToString("HH:mm"))"
                 data-peer-end="@(missing.PeerEnd?.ToString("HH:mm"))"
                 data-gps-start="@(missing.GpsSiteStart?.ToString("HH:mm"))"
                 data-gps-end="@(missing.GpsSiteEnd?.ToString("HH:mm"))"></div>
        }

        <section class="border-top pt-3" id="wb-decisions" data-admin-case-key="@selected.AdminCaseKey">
            <div class="text-uppercase small text-muted fw-semibold mb-2">Andere beslissing</div>
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var choice in selected.Choices)
                {
                    if (string.Equals(choice.DecisionCode, PayrollGuidedDecisionCodes.MissingTechConfirmed, StringComparison.Ordinal))
                    {
                        continue;
                    }
                    <button type="button"
                            class="btn btn-sm btn-outline-dark wb-decide"
                            data-decision="@choice.DecisionCode"
                            data-label="@choice.Label"
                            data-requires-comment="@(choice.RequiresComment ? "true" : "false")">@choice.Label</button>
                }
            </div>
            <label class="form-label small mb-1" for="wb-comment">Toelichting</label>
            <textarea id="wb-comment" class="form-control form-control-sm mb-2" rows="2" placeholder="Optioneel / verplicht bij sommige keuzes">@selected.ReviewComment</textarea>
            <div class="alert alert-danger small d-none mb-0" id="wb-decide-error"></div>
        </section>
    </div>
}
